{
  "name": "nucleo-web",
  "version": "0.2.0",
  "description": "Núcleo reutilizable de módulos para sitios Astro + Cloudflare Pages: cotización, carrito y pago (Flow + Mercado Pago).",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./cotizacion": "./modulos/cotizacion/index.ts",
    "./cotizacion/QuoteForm.astro": "./modulos/cotizacion/ui-defecto/QuoteForm.astro",
    "./carrito": "./modulos/carrito/index.ts",
    "./carrito/BotonAgregar.astro": "./modulos/carrito/ui-defecto/BotonAgregar.astro",
    "./carrito/Carrito.astro": "./modulos/carrito/ui-defecto/Carrito.astro",
    "./pago": "./modulos/pago/index.ts",
    "./core/tipos": "./core/tipos.ts",
    "./core/validar": "./core/validar.ts",
    "./core/seguridad": "./core/seguridad.ts",
    "./core/correo": "./core/correo.ts",
    "./core/cripto": "./core/cripto.ts",
    "./core/red": "./core/red.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx pruebas/exports.test.ts && tsx pruebas/cotizacion.test.ts && tsx pruebas/carrito.test.ts && tsx pruebas/pago.test.ts"
  }
}
