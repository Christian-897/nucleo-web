{
  "name": "nucleo-web",
  "version": "0.4.0",
  "description": "Núcleo reutilizable de módulos para sitios Astro + Cloudflare Pages: catálogo, carrito, pago (Flow + Mercado Pago), compra, newsletter, cotización y aviso de construcción.",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./cotizacion": "./modulos/cotizacion/index.ts",
    "./cotizacion/QuoteForm.astro": "./modulos/cotizacion/ui-defecto/QuoteForm.astro",
    "./carrito": "./modulos/carrito/index.ts",
    "./carrito/BotonAgregar.astro": "./modulos/carrito/ui-defecto/BotonAgregar.astro",
    "./carrito/Carrito.astro": "./modulos/carrito/ui-defecto/Carrito.astro",
    "./pago": "./modulos/pago/index.ts",
    "./core/tipos": "./core/tipos.ts",
    "./core/validar": "./core/validar.ts",
    "./core/seguridad": "./core/seguridad.ts",
    "./core/correo": "./core/correo.ts",
    "./core/cripto": "./core/cripto.ts",
    "./core/red": "./core/red.ts",
    "./newsletter": "./modulos/newsletter/index.ts",
    "./newsletter/cliente": "./modulos/newsletter/cliente.ts",
    "./catalogo": "./modulos/catalogo/index.ts",
    "./catalogo/cliente": "./modulos/catalogo/cliente.ts",
    "./compra": "./modulos/compra/index.ts",
    "./compra/cliente": "./modulos/compra/cliente.ts",
    "./core/turnstile": "./core/turnstile-cliente.ts",
    "./construccion": "./modulos/construccion/index.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx pruebas/exports.test.ts && tsx pruebas/cotizacion.test.ts && tsx pruebas/carrito.test.ts && tsx pruebas/pago.test.ts && tsx pruebas/newsletter.test.ts && tsx pruebas/compra.test.ts && tsx pruebas/construccion.test.ts"
  }
}
