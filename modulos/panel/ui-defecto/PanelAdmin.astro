---
/**
 * Pantalla del panel, lista para usar en cualquier sitio:
 *
 *   ---  // src/pages/admin/index.astro
 *   import PanelAdmin from "nucleo-web/panel/PanelAdmin.astro";
 *   ---
 *   <PanelAdmin nombre="Mi Tienda" logo="/img/logo.png" />
 *
 * Toma los colores del sitio con variables CSS (--pa-acento, etc.). Toda
 * la lógica vive en panel-app.ts y en el cliente del módulo. Cumple la CSP
 * del panel: sin estilos ni scripts en línea, nada externo.
 */
interface Props {
  nombre: string;
  logo?: string;
  /** Dirección pública de la tienda, para el botón "Ver tienda". */
  tienda?: string;
  /** Cuántos destacados muestra el inicio (para avisarlo en el panel). */
  maxDestacados?: number;
  /** Colores (hex). Por defecto un rosado sobrio. */
  colores?: { acento?: string; acentoOscuro?: string; fondo?: string; tinta?: string };
  /**
   * Colores de los gráficos (hex), en orden: torta y barras de "Más vendidos"
   * y "Medios de pago" usan los 5; el segundo es el año comparado. Conviene
   * pasarlos por el validador de paletas (daltonismo y contraste) antes de
   * usarlos. Sin esto se usa una paleta neutra ya validada.
   */
  coloresGraficos?: string[];
  /** Muestra la pestaña Portada (el sitio montó el carrusel editable). */
  carrusel?: boolean;
  /** Muestra la pestaña "Diseño y textos" (el sitio montó el contenido editable). */
  contenido?: boolean;
}
import { LIMITES } from "../../carrusel/tipos";
import { LIMITES_CATEGORIA } from "../../catalogo/categorias";
const { nombre, logo, tienda = "/", colores = {}, maxDestacados, coloresGraficos = [], carrusel = false, contenido = false } = Astro.props;
const COLOR = /^#[0-9a-fA-F]{3,8}$/;
const c = (v: string | undefined, d: string) => (v && COLOR.test(v) ? v : d);
const tema = {
  acento: c(colores.acento, "#C2185B"),
  acentoOscuro: c(colores.acentoOscuro, "#9C1449"),
  fondo: c(colores.fondo, "#FBF7F9"),
  tinta: c(colores.tinta, "#221A1F"),
};
const graficos = coloresGraficos.filter((x) => COLOR.test(x)).slice(0, 5).join(",");
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel | {nombre}</title>
  <link rel="icon" href={logo ?? "/favicon.ico"} />
</head>
<body class="pa-cuerpo">
<div
  class="pa"
  data-panel
  data-nombre={nombre}
  data-acento={tema.acento}
  data-acento-oscuro={tema.acentoOscuro}
  data-fondo={tema.fondo}
  data-tinta={tema.tinta}
  data-graficos={graficos || undefined}
  data-max-destacados={maxDestacados}
>
  <a class="pa-saltar" href="#pa-principal">Saltar al contenido</a>

  <header class="pa-cabecera" data-solo-sesion hidden>
    <div class="pa-marca">
      {logo && <img src={logo} alt="" width="40" height="40" />}
      <span><strong>{nombre}</strong><small>Panel de administración</small></span>
    </div>
    <nav class="pa-pestanas" aria-label="Secciones">
      <button type="button" data-tab="resumen" aria-current="page">Resumen</button>
      <button type="button" data-tab="productos">Productos</button>
      <button type="button" data-tab="categorias">Categorías</button>
      <button type="button" data-tab="portada" hidden={!carrusel}>Portada</button>
      <button type="button" data-tab="sitio" hidden={!contenido}>Diseño y textos</button>
      <button type="button" data-tab="pedidos">Pedidos</button>
      <button type="button" data-tab="suscriptores">Suscriptores</button>
      <button type="button" data-tab="seguridad">Seguridad</button>
    </nav>
    <div class="pa-acciones">
      <a class="pa-boton pa-boton--suave" href={tienda} target="_blank" rel="noopener">Ver tienda ↗</a>
      <button class="pa-boton pa-boton--suave" type="button" data-salir>Salir</button>
    </div>
  </header>

  <main id="pa-principal" class="pa-principal">
    <!-- ───────────── acceso ───────────── -->
    <section class="pa-vista pa-centro" data-vista="cargando" aria-live="polite">
      <p class="pa-tenue">Cargando el panel…</p>
    </section>

    <section class="pa-vista pa-centro" data-vista="no-disponible" hidden>
      <div class="pa-caja">
        <h1>El panel no está disponible</h1>
        <p data-no-disponible-texto>Falta configuración en el servidor.</p>
      </div>
    </section>

    <section class="pa-vista pa-centro" data-vista="instalar" hidden>
      <form class="pa-caja" data-form="instalar" novalidate>
        {logo && <img class="pa-logo-grande" src={logo} alt="" width="96" height="96" />}
        <h1>Crear tu usuario</h1>
        <p class="pa-tenue">Esto se hace una sola vez. Guarda tu contraseña en un lugar seguro.</p>
        <label class="pa-campo">Usuario<input name="usuario" autocomplete="username" required minlength="3" maxlength="40" /></label>
        <label class="pa-campo">Contraseña (mínimo 10 caracteres)<input name="clave" type="password" autocomplete="new-password" required minlength="10" /></label>
        <label class="pa-campo">Repite la contraseña<input name="repetir" type="password" autocomplete="new-password" required /></label>
        <label class="pa-campo">Clave de instalación<input name="claveInstalacion" type="password" autocomplete="off" required /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Crear usuario</button>
      </form>
    </section>

    <section class="pa-vista pa-centro" data-vista="entrar" hidden>
      <form class="pa-caja" data-form="entrar" novalidate>
        {logo && <img class="pa-logo-grande" src={logo} alt="" width="96" height="96" />}
        <h1>Entrar al panel</h1>
        <p class="pa-aviso" data-aviso-entrar hidden></p>
        <label class="pa-campo">Usuario<input name="usuario" autocomplete="username" required /></label>
        <label class="pa-campo">Contraseña<input name="clave" type="password" autocomplete="current-password" required /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Entrar</button>
      </form>
    </section>

    <section class="pa-vista pa-centro" data-vista="codigo" hidden>
      <form class="pa-caja" data-form="codigo" novalidate>
        <h1>Código de verificación</h1>
        <p class="pa-tenue">Escribe los 6 dígitos de tu app autenticadora, o uno de tus códigos de respaldo.</p>
        <label class="pa-campo">Código<input name="codigo" inputmode="numeric" autocomplete="one-time-code" required maxlength="11" /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Verificar</button>
        <button class="pa-enlace" type="button" data-volver-entrar>Volver</button>
      </form>
    </section>

    <!-- ───────────── productos ───────────── -->
    <section class="pa-vista" data-vista="productos" hidden>
      <div class="pa-titulo">
        <h1>Productos</h1>
        <button class="pa-boton" type="button" data-nuevo-producto>+ Nuevo producto</button>
      </div>
      <div class="pa-filtros">
        <label class="pa-campo pa-campo--fila">Buscar<input type="search" data-buscar-producto placeholder="Nombre…" /></label>
        <label class="pa-campo pa-campo--fila">Categoría<select data-filtro-categoria><option value="">Todas</option></select></label>
      </div>
      <p class="pa-tenue" data-resumen-productos></p>
      <ul class="pa-lista" data-lista-productos aria-live="polite"></ul>
    </section>

    <!-- ───────────── categorías ───────────── -->
    <section class="pa-vista" data-vista="categorias" hidden>
      <div class="pa-titulo"><h1>Categorías</h1></div>
      <p class="pa-tenue">Cambia el nombre y la foto de cada categoría. Se actualiza en el menú, el inicio y la tienda en unos segundos.</p>
      <ul class="pa-lista" data-lista-categorias aria-live="polite"></ul>
      <p class="pa-tenue pa-chico">¿Necesitas una categoría nueva? Lleva su propia página en la tienda: pídesela a quien mantiene el sitio.</p>
      <button class="pa-enlace" type="button" data-restablecer-categorias hidden>Volver a los nombres y fotos originales</button>
    </section>

    <!-- ───────────── diseño y textos (contenido) ───────────── -->
    <section class="pa-vista" data-vista="sitio" hidden>
      <div class="pa-titulo">
        <h1>Diseño y textos</h1>
        <a class="pa-boton pa-boton--suave" href={tienda} target="_blank" rel="noopener">Ver tienda ↗</a>
      </div>
      <p class="pa-tenue">Elige una sección, cambia lo que quieras y pulsa <strong>Guardar</strong>. El sitio se actualiza en unos segundos.</p>
      <div class="pa-secciones" role="group" aria-label="Secciones" data-sitio-grupos></div>
      <form class="pa-panel pa-sitio" data-form="sitio" novalidate>
        <h2 data-sitio-titulo></h2>
        <p class="pa-tenue" data-sitio-descripcion></p>
        <div data-sitio-extra></div>
        <div class="pa-sitio__campos" data-sitio-campos></div>
        <p class="pa-error" role="alert" data-error></p>
        <div class="pa-sitio__pie">
          <button class="pa-enlace" type="button" data-sitio-restablecer>Volver a lo original en esta sección</button>
          <button class="pa-boton" type="submit">Guardar</button>
        </div>
      </form>
    </section>

    <!-- ───────────── portada (carrusel) ───────────── -->
    <section class="pa-vista" data-vista="portada" hidden>
      <div class="pa-titulo">
        <h1>Portada</h1>
        <div class="pa-fila__botones">
          <a class="pa-boton pa-boton--suave" href={tienda} target="_blank" rel="noopener">Ver portada ↗</a>
          <button class="pa-boton" type="button" data-nueva-diapo>+ Nueva diapositiva</button>
        </div>
      </div>
      <p class="pa-tenue">Las fotos grandes del inicio de la tienda. Se muestran en este orden y los cambios se ven en unos segundos.</p>
      <div class="pa-panel pa-portada-ajustes">
        <label class="pa-casilla"><input type="checkbox" data-carrusel-automatico /> Avanzar solas</label>
        <label class="pa-campo pa-campo--fila">Cambiar cada<select data-carrusel-segundos></select></label>
        <label class="pa-campo pa-campo--fila">Botones
          <select data-carrusel-controles>
            <option value="burbuja">Cápsula blanca (pausa, flechas y puntos)</option>
            <option value="minimo">Mínimo (puntos blancos; flechas al pasar el mouse)</option>
            <option value="lineas">Líneas finas de progreso</option>
            <option value="discreto">Discreto (solo pausa)</option>
          </select>
        </label>
        <p class="pa-tenue pa-chico">Siempre se pueden pausar. No avanzan solas si la persona pidió "reducir movimiento" en su teléfono o computador.</p>
      </div>
      <ul class="pa-lista" data-lista-diapos aria-live="polite"></ul>
      <p class="pa-tenue pa-chico" data-portada-estado></p>
      <button class="pa-enlace" type="button" data-restablecer-portada hidden>Volver a la portada original del sitio</button>
    </section>

    <!-- ───────────── resumen (métricas) ───────────── -->
    <section class="pa-vista" data-vista="resumen" hidden>
      <div class="pa-titulo">
        <h1>Resumen</h1>
        <button class="pa-boton pa-boton--suave pa-boton--chico" type="button" data-resumen-recargar>Actualizar</button>
      </div>
      <p class="pa-aviso pa-aviso--despacho" data-resumen-despacho hidden>
        <span data-resumen-despacho-texto></span>
        <button class="pa-enlace" type="button" data-ir-pedidos>Ver pedidos</button>
      </p>
      <div class="pa-kpis">
        <div class="pa-kpi"><p class="pa-kpi__titulo">Ventas de hoy</p><p class="pa-kpi__valor" data-kpi="hoy">—</p><p class="pa-kpi__nota" data-kpi-nota="hoy"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Últimos 7 días</p><p class="pa-kpi__valor" data-kpi="d7">—</p><p class="pa-kpi__nota" data-kpi-nota="d7"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Últimos 30 días</p><p class="pa-kpi__valor" data-kpi="d30">—</p><p class="pa-kpi__nota" data-kpi-nota="d30"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Venta promedio</p><p class="pa-kpi__valor" data-kpi="ticket">—</p><p class="pa-kpi__nota">por pedido, últimos 30 días</p></div>
      </div>
      <div class="pa-titulo-seccion">
        <h2 class="pa-subtitulo">Visitas</h2>
        <div class="pa-segmento" role="group" aria-label="Período de visitas" data-visitas-periodo>
          <button type="button" data-dias="7">7 días</button>
          <button type="button" data-dias="30">30 días</button>
        </div>
      </div>
      <p class="pa-aviso" data-visitas-aviso hidden></p>
      <div data-visitas-datos hidden>
        <div class="pa-kpis">
          <div class="pa-kpi"><p class="pa-kpi__titulo">Visitas</p><p class="pa-kpi__valor" data-kpi="visitas">—</p><p class="pa-kpi__nota">personas que llegaron a la tienda</p></div>
          <div class="pa-kpi"><p class="pa-kpi__titulo">Páginas vistas</p><p class="pa-kpi__valor" data-kpi="paginas">—</p><p class="pa-kpi__nota" data-kpi-nota="paginas"></p></div>
          <div class="pa-kpi"><p class="pa-kpi__titulo">Compran</p><p class="pa-kpi__valor" data-kpi="conversion">—</p><p class="pa-kpi__nota" data-kpi-nota="conversion"></p></div>
        </div>
        <div class="pa-panel">
          <h2>Visitas por día</h2>
          <div class="pa-grafico">
            <svg data-visitas-svg viewBox="0 0 640 200" role="img" aria-label="Visitas por día"></svg>
            <div class="pa-grafico__tooltip" data-visitas-tooltip role="status" hidden></div>
          </div>
        </div>
        <div class="pa-columnas">
          <div class="pa-panel"><h2>Páginas más vistas</h2><div class="pa-partes" data-visitas-paginas></div></div>
          <div class="pa-panel"><h2>De dónde llegan</h2><div class="pa-partes" data-visitas-origenes></div></div>
          <div class="pa-panel"><h2>Países</h2><div class="pa-partes" data-visitas-paises></div></div>
          <div class="pa-panel"><h2>Dispositivos</h2><div class="pa-partes" data-visitas-dispositivos></div></div>
        </div>
        <p class="pa-tenue pa-chico" data-visitas-nota></p>
      </div>

      <h2 class="pa-subtitulo">Explorar ventas</h2>
      <form class="pa-panel pa-periodo" data-form-periodo>
        <div class="pa-periodo__atajos" role="group" aria-label="Períodos rápidos">
          <button type="button" class="pa-chip" data-atajo="7">7 días</button>
          <button type="button" class="pa-chip" data-atajo="30">30 días</button>
          <button type="button" class="pa-chip" data-atajo="este-mes">Este mes</button>
          <button type="button" class="pa-chip" data-atajo="mes-pasado">Mes pasado</button>
          <button type="button" class="pa-chip" data-atajo="este-anio">Este año</button>
          <button type="button" class="pa-chip" data-atajo="anio-pasado">Año pasado</button>
        </div>
        <div class="pa-periodo__campos">
          <label class="pa-campo">Desde<input type="date" name="desde" required /></label>
          <label class="pa-campo">Hasta<input type="date" name="hasta" required /></label>
          <label class="pa-campo">Agrupar por<select name="agrupar"><option value="dia">Día</option><option value="semana">Semana</option><option value="mes">Mes</option></select></label>
          <button class="pa-boton" type="submit">Ver</button>
        </div>
        <p class="pa-error" role="alert" data-error-periodo></p>
      </form>
      <p class="pa-aviso" data-periodo-aproximado hidden></p>
      <div class="pa-kpis">
        <div class="pa-kpi"><p class="pa-kpi__titulo">Ventas del período</p><p class="pa-kpi__valor" data-kpi="rango">—</p><p class="pa-kpi__nota" data-kpi-nota="rango"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Pedidos</p><p class="pa-kpi__valor" data-kpi="rango-pedidos">—</p><p class="pa-kpi__nota" data-kpi-nota="rango-pedidos"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Venta promedio</p><p class="pa-kpi__valor" data-kpi="rango-ticket">—</p><p class="pa-kpi__nota">por pedido en el período</p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Período anterior</p><p class="pa-kpi__valor" data-kpi="rango-anterior">—</p><p class="pa-kpi__nota" data-kpi-nota="rango-anterior"></p></div>
      </div>
      <div class="pa-panel">
        <div class="pa-panel__cabeza">
          <h2 data-titulo-serie>Ventas en el período</h2>
          <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="tiempo">
            <button type="button" data-tipo="barras">Barras</button>
            <button type="button" data-tipo="linea">Línea</button>
          </div>
        </div>
        <div class="pa-grafico">
          <svg data-grafico-svg viewBox="0 0 640 200" role="img" aria-label="Ventas en el período"></svg>
          <div class="pa-grafico__tooltip" data-grafico-tooltip role="status" hidden></div>
        </div>
        <details class="pa-tabla-detalle">
          <summary>Ver como tabla</summary>
          <table class="pa-tabla"><thead><tr><th scope="col">Período</th><th scope="col">Pedidos</th><th scope="col">Ventas</th></tr></thead><tbody data-tabla-ventas></tbody></table>
        </details>
      </div>
      <div class="pa-columnas">
        <div class="pa-panel">
          <div class="pa-panel__cabeza">
            <h2>Más vendidos</h2>
            <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="productos">
              <button type="button" data-tipo="lista">Lista</button>
              <button type="button" data-tipo="barras">Barras</button>
              <button type="button" data-tipo="torta">Torta</button>
            </div>
          </div>
          <div class="pa-partes" data-top-productos></div>
        </div>
        <div class="pa-panel">
          <div class="pa-panel__cabeza">
            <h2>Medios de pago</h2>
            <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="medios">
              <button type="button" data-tipo="lista">Lista</button>
              <button type="button" data-tipo="barras">Barras</button>
              <button type="button" data-tipo="torta">Torta</button>
            </div>
          </div>
          <div class="pa-partes" data-medios></div>
        </div>
      </div>
      <h2 class="pa-subtitulo">Comparación por años</h2>
      <div class="pa-kpis pa-kpis--dos">
        <div class="pa-kpi"><p class="pa-kpi__titulo" data-kpi-anio-titulo>Este año a la fecha</p><p class="pa-kpi__valor" data-kpi="anio">—</p><p class="pa-kpi__nota" data-kpi-nota="anio"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo" data-kpi-anio-anterior-titulo>Año anterior a la misma fecha</p><p class="pa-kpi__valor" data-kpi="anio-anterior">—</p><p class="pa-kpi__nota" data-kpi-nota="anio-anterior"></p></div>
      </div>
      <div class="pa-panel">
        <div class="pa-panel__cabeza">
          <h2>Ventas por mes</h2>
          <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="anios">
            <button type="button" data-tipo="barras">Barras</button>
            <button type="button" data-tipo="linea">Línea</button>
          </div>
          <div class="pa-comparar">
            <label class="pa-campo pa-campo--fila">Comparar<select data-anio-a aria-label="Año principal"></select></label>
            <label class="pa-campo pa-campo--fila">con<select data-anio-b aria-label="Año a comparar"></select></label>
          </div>
        </div>
        <ul class="pa-leyenda" aria-label="Leyenda">
          <li><span class="pa-leyenda__muestra"></span><span data-leyenda-a></span></li>
          <li><span class="pa-leyenda__muestra pa-leyenda__muestra--b"></span><span data-leyenda-b></span></li>
        </ul>
        <div class="pa-grafico">
          <svg data-comparacion-svg viewBox="0 0 640 200" role="img" aria-label="Ventas por mes de dos años"></svg>
          <div class="pa-grafico__tooltip" data-comparacion-tooltip role="status" hidden></div>
        </div>
        <details class="pa-tabla-detalle">
          <summary>Ver como tabla</summary>
          <table class="pa-tabla"><thead><tr><th scope="col">Mes</th><th scope="col" data-th-a></th><th scope="col" data-th-b></th><th scope="col">Variación</th></tr></thead><tbody data-tabla-comparacion></tbody></table>
        </details>
      </div>
      <div class="pa-panel">
        <h2>Historial por año</h2>
        <div class="pa-partes" data-historial-anios></div>
      </div>
      <p class="pa-tenue pa-chico">Las visitas al sitio (cuántas personas entran y desde dónde) se ven en Cloudflare → Web Analytics.</p>
    </section>

    <!-- ───────────── pedidos ───────────── -->
    <section class="pa-vista" data-vista="pedidos" hidden>
      <div class="pa-titulo">
        <h1>Pedidos</h1>
        <label class="pa-casilla"><input type="checkbox" data-pedidos-todos /> Ver también los no pagados</label>
      </div>
      <p class="pa-tenue" data-resumen-pedidos></p>
      <ul class="pa-lista" data-lista-pedidos aria-live="polite"></ul>
    </section>

    <!-- ───────────── suscriptores ───────────── -->
    <section class="pa-vista" data-vista="suscriptores" hidden>
      <div class="pa-titulo"><h1>Suscriptores del newsletter</h1></div>
      <div class="pa-caja pa-caja--ancha">
        <p class="pa-numero" data-total-suscriptores>—</p>
        <p class="pa-tenue">personas confirmaron su suscripción.</p>
        <button class="pa-boton" type="button" data-descargar-csv>Descargar lista (CSV)</button>
        <p class="pa-tenue pa-chico">Ábrela en Excel o súbela a tu herramienta de correos. Cada envío debe incluir el enlace para darse de baja.</p>
      </div>
    </section>

    <!-- ───────────── seguridad ───────────── -->
    <section class="pa-vista" data-vista="seguridad" hidden>
      <div class="pa-titulo"><h1>Seguridad</h1></div>

      <div class="pa-caja pa-caja--ancha">
        <h2>Doble factor</h2>
        <p data-estado-2fa class="pa-tenue">—</p>
        <div data-2fa-apagado hidden>
          <p>Con el doble factor, además de tu contraseña se pide un código de tu teléfono. Es la mejor protección para tu tienda.</p>
          <button class="pa-boton" type="button" data-2fa-proponer>Activar doble factor</button>
          <div data-2fa-propuesta hidden class="pa-propuesta">
            <ol>
              <li>Instala una app autenticadora (Google Authenticator, Microsoft Authenticator o similar).</li>
              <li>Escanea este código con la app:</li>
            </ol>
            <img data-2fa-qr alt="Código QR para configurar el doble factor" width="200" height="200" />
            <p class="pa-tenue pa-chico">¿No puedes escanear? Escribe esta clave en la app: <code data-2fa-secreto></code></p>
            <form data-form="2fa-activar" novalidate>
              <label class="pa-campo">Escribe el código de 6 dígitos que muestra la app<input name="codigo" inputmode="numeric" maxlength="6" required /></label>
              <p class="pa-error" role="alert" data-error></p>
              <button class="pa-boton" type="submit">Confirmar y activar</button>
            </form>
          </div>
        </div>
        <div data-2fa-encendido hidden>
          <form data-form="2fa-respaldos" class="pa-en-linea" novalidate>
            <label class="pa-campo">Código actual<input name="codigo" inputmode="numeric" maxlength="11" required /></label>
            <button class="pa-boton pa-boton--suave" type="submit">Generar códigos de respaldo nuevos</button>
            <p class="pa-error" role="alert" data-error></p>
          </form>
          <details class="pa-detalles">
            <summary>Desactivar el doble factor</summary>
            <form data-form="2fa-desactivar" novalidate>
              <label class="pa-campo">Tu contraseña<input name="clave" type="password" autocomplete="current-password" required /></label>
              <label class="pa-campo">Código actual<input name="codigo" inputmode="numeric" maxlength="11" required /></label>
              <p class="pa-error" role="alert" data-error></p>
              <button class="pa-boton pa-boton--peligro" type="submit">Desactivar</button>
            </form>
          </details>
        </div>
        <div data-respaldos hidden class="pa-respaldos">
          <p><strong>Guarda estos códigos de respaldo.</strong> Cada uno sirve una sola vez si pierdes tu teléfono. No se volverán a mostrar.</p>
          <ul data-lista-respaldos></ul>
          <button class="pa-boton" type="button" data-respaldos-listo>Ya los guardé</button>
        </div>
      </div>

      <div class="pa-caja pa-caja--ancha">
        <h2>Cambiar contraseña</h2>
        <form data-form="clave" novalidate>
          <label class="pa-campo">Contraseña actual<input name="actual" type="password" autocomplete="current-password" required /></label>
          <label class="pa-campo">Contraseña nueva (mínimo 10 caracteres)<input name="nueva" type="password" autocomplete="new-password" required minlength="10" /></label>
          <label class="pa-campo">Repite la nueva<input name="repetir" type="password" autocomplete="new-password" required /></label>
          <label class="pa-campo" data-si-2fa hidden>Código de tu app<input name="codigo" inputmode="numeric" maxlength="11" /></label>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Cambiar contraseña</button>
        </form>
      </div>

      <div class="pa-caja pa-caja--ancha">
        <h2>Cierre por inactividad</h2>
        <p class="pa-tenue">Si nadie usa el panel durante este tiempo, la sesión se cierra sola.</p>
        <label class="pa-campo pa-campo--fila">Cerrar la sesión después de
          <select data-inactividad></select>
        </label>
      </div>
    </section>
  </main>

  <!-- editor de producto -->
  <dialog class="pa-dialogo" data-editor aria-labelledby="pa-editor-titulo">
    <form data-form="producto" novalidate>
      <h2 id="pa-editor-titulo" data-editor-titulo>Producto</h2>
      <div class="pa-editor">
        <div class="pa-editor__foto">
          <img data-editor-foto alt="" width="240" height="240" />
          <label class="pa-boton pa-boton--suave pa-archivo">
            Elegir foto
            <input type="file" accept="image/jpeg,image/png,image/webp" data-editor-archivo />
          </label>
          <p class="pa-tenue pa-chico">Se recorta cuadrada al centro y se achica sola.</p>
          <p class="pa-error" role="alert" data-error-foto></p>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Nombre<input name="nombre" maxlength="80" required /></label>
          <p class="pa-error" data-error-campo="nombre"></p>
          <div class="pa-dos">
            <label class="pa-campo">Precio (CLP)<input name="precio" inputmode="numeric" required /></label>
            <label class="pa-campo">Disponible<input name="disponible" inputmode="numeric" placeholder="Sin límite" /></label>
          </div>
          <p class="pa-error" data-error-campo="precio"></p>
          <p class="pa-error" data-error-campo="disponible"></p>
          <p class="pa-tenue pa-chico" data-editor-vendidos></p>
          <label class="pa-campo">Categoría<select name="categoria" data-editor-categorias required></select></label>
          <p class="pa-error" data-error-campo="categoria"></p>
          <fieldset class="pa-opciones">
            <legend>Tipo</legend>
            <label class="pa-casilla"><input type="radio" name="tipo" value="fisico" /> Físico (se despacha)</label>
            <label class="pa-casilla"><input type="radio" name="tipo" value="digital" /> Digital (curso o patrón por correo)</label>
          </fieldset>
          <p class="pa-error" data-error-campo="tipo"></p>
          <label class="pa-campo">Descripción<textarea name="descripcion" rows="4" maxlength="1000"></textarea></label>
          <p class="pa-error" data-error-campo="descripcion"></p>
          <label class="pa-casilla"><input type="checkbox" name="destacado" /> Mostrar en "Productos destacados" del inicio</label>
        </div>
      </div>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-editor>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar</button>
      </div>
    </form>
  </dialog>

  <!-- editor de categoría -->
  <dialog class="pa-dialogo" data-editor-categoria aria-labelledby="pa-categoria-titulo">
    <form data-form="categoria" novalidate>
      <h2 id="pa-categoria-titulo" data-categoria-titulo>Categoría</h2>
      <div class="pa-editor">
        <div class="pa-editor__foto">
          <img data-categoria-foto alt="" width="240" height="240" />
          <label class="pa-boton pa-boton--suave pa-archivo">
            Elegir foto
            <input type="file" accept="image/jpeg,image/png,image/webp" data-categoria-archivo />
          </label>
          <p class="pa-tenue pa-chico">Se recorta cuadrada al centro y se achica sola.</p>
          <p class="pa-error" role="alert" data-error-foto-categoria></p>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Nombre<input name="nombre" maxlength={LIMITES_CATEGORIA.nombre} required /></label>
          <p class="pa-error" data-error-categoria="nombre"></p>
          <label class="pa-campo">Nombre corto (opcional)<input name="corto" maxlength={LIMITES_CATEGORIA.corto} /></label>
          <p class="pa-error" data-error-categoria="corto"></p>
          <p class="pa-tenue pa-chico">Se usa donde hay poco espacio: las tarjetas del inicio y los botones de la tienda. Vacío = igual al nombre.</p>
          <p class="pa-tenue pa-chico" data-categoria-original></p>
        </div>
      </div>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-categoria>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar</button>
      </div>
    </form>
  </dialog>

  <!-- editor de diapositiva (portada) -->
  <dialog class="pa-dialogo" data-editor-diapo aria-labelledby="pa-diapo-titulo">
    <form data-form="diapo" novalidate>
      <h2 id="pa-diapo-titulo" data-diapo-titulo>Diapositiva</h2>
      <div class="pa-editor pa-editor--ancho">
        <div class="pa-editor__foto">
          <img class="pa-foto-ancha" data-diapo-foto alt="" width="320" height="200" />
          <label class="pa-boton pa-boton--suave pa-archivo">
            Elegir foto
            <input type="file" accept="image/jpeg,image/png,image/webp" data-diapo-archivo />
          </label>
          <p class="pa-tenue pa-chico">Mejor horizontal. Se achica sola, sin recortarla.</p>
          <p class="pa-error" role="alert" data-error-foto-diapo></p>
          <fieldset class="pa-opciones">
            <legend>Si la foto se recorta, que se vea su parte…</legend>
            <label class="pa-casilla"><input type="radio" name="enfoque" value="izquierda" /> Izquierda</label>
            <label class="pa-casilla"><input type="radio" name="enfoque" value="centro" /> Centro</label>
            <label class="pa-casilla"><input type="radio" name="enfoque" value="derecha" /> Derecha</label>
          </fieldset>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Qué muestra la foto<input name="imagenAlt" maxlength={LIMITES.imagenAlt} required placeholder="Ej: gatito tejido a crochet entre ovillos de lana" /></label>
          <p class="pa-error" data-error-diapo="imagenAlt"></p>
          <label class="pa-campo">Texto chico sobre el título (opcional)<input name="antetitulo" maxlength={LIMITES.antetitulo} /></label>
          <p class="pa-error" data-error-diapo="antetitulo"></p>
          <label class="pa-campo">Título<input name="titulo" maxlength={LIMITES.titulo} /></label>
          <p class="pa-error" data-error-diapo="titulo"></p>
          <label class="pa-campo">Subtítulo (opcional)<input name="subtitulo" maxlength={LIMITES.subtitulo} /></label>
          <p class="pa-error" data-error-diapo="subtitulo"></p>
          <label class="pa-campo">Texto (opcional)<textarea name="texto" rows="3" maxlength={LIMITES.texto}></textarea></label>
          <p class="pa-error" data-error-diapo="texto"></p>
          <div class="pa-dos">
            <label class="pa-campo">Texto del botón<input name="botonTexto" maxlength={LIMITES.botonTexto} placeholder="Ver productos" /></label>
            <label class="pa-campo">El botón lleva a<input name="enlace" maxlength={LIMITES.enlace} placeholder="/tienda/" /></label>
          </div>
          <p class="pa-error" data-error-diapo="botonTexto"></p>
          <p class="pa-error" data-error-diapo="enlace"></p>
          <p class="pa-tenue pa-chico">Una página de la tienda (ej. /tienda/flores/) o una dirección que empiece con https://. Deja los dos vacíos para no mostrar botón.</p>
        </div>
      </div>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-diapo>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar</button>
      </div>
    </form>
  </dialog>

  <!-- aviso de inactividad -->
  <dialog class="pa-dialogo pa-dialogo--chico" data-aviso-inactividad>
    <h2>¿Sigues ahí?</h2>
    <p>Por seguridad, la sesión se cerrará en un minuto.</p>
    <button class="pa-boton" type="button" data-seguir>Seguir trabajando</button>
  </dialog>

  <div class="pa-toast" role="status" aria-live="polite" data-toast hidden></div>
</div>
</body>
</html>

<style is:global>
  .pa-cuerpo { margin: 0; background: #fbf7f9; color: #221a1f; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 16px; line-height: 1.5; }
  .pa { --pa-acento: #c2185b; --pa-acento-oscuro: #9c1449; --pa-fondo: #fbf7f9; --pa-tinta: #221a1f; --pa-suave: #6e5f68; --pa-borde: #eadfe4; --pa-error: #b3261e; --pa-ok: #2f7a52; --pa-serie-1: #2a78d6; --pa-serie-2: #eb6834; --pa-serie-3: #1baf7a; --pa-serie-4: #eda100; --pa-serie-5: #e87ba4; --pa-comparacion: #2a78d6; min-height: 100vh; background: var(--pa-fondo); color: var(--pa-tinta); }
  .pa *, .pa *::before, .pa *::after { box-sizing: border-box; }
  .pa [hidden] { display: none !important; }
  .pa :focus-visible { outline: 3px solid var(--pa-acento); outline-offset: 2px; }
  .pa h1 { font-size: 1.6rem; margin: 0; font-weight: 650; }
  .pa h2 { font-size: 1.1rem; margin: 0 0 8px; font-weight: 600; }
  .pa-saltar { position: absolute; left: -9999px; }
  .pa-saltar:focus { left: 12px; top: 12px; background: #fff; padding: 8px 12px; z-index: 10; }
  .pa-tenue { color: var(--pa-suave); }
  .pa-chico { font-size: .85rem; }

  .pa-cabecera { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 10px 20px; background: #fff; border-bottom: 1px solid var(--pa-borde); position: sticky; top: 0; z-index: 5; }
  .pa-marca { display: flex; align-items: center; gap: 10px; }
  .pa-marca img { border-radius: 50%; }
  .pa-marca span { display: grid; line-height: 1.2; }
  .pa-marca small { color: var(--pa-suave); font-size: .78rem; }
  .pa-pestanas { display: flex; gap: 2px; flex-wrap: wrap; margin-left: auto; }
  .pa-pestanas button { border: 0; background: none; padding: 7px 9px; border-radius: 999px; font: inherit; font-size: .94rem; font-weight: 500; color: var(--pa-tinta); cursor: pointer; white-space: nowrap; }
  .pa-pestanas button[aria-current="page"] { background: var(--pa-acento); color: #fff; font-weight: 600; }
  .pa-acciones { display: flex; gap: 8px; }
  .pa-acciones .pa-boton { padding: 7px 14px; font-size: .94rem; }

  .pa-principal { max-width: 1080px; margin: 0 auto; padding: 24px 16px 64px; }
  .pa-centro { display: grid; place-items: center; min-height: 80vh; }
  .pa-caja { background: #fff; border: 1px solid var(--pa-borde); border-radius: 16px; padding: 24px; width: min(100%, 420px); display: grid; gap: 12px; }
  .pa-caja--ancha { width: 100%; margin-bottom: 16px; }
  .pa-logo-grande { width: 96px; height: 96px; border-radius: 50%; justify-self: center; }
  .pa-titulo { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .pa-numero { font-size: 2.6rem; font-weight: 650; margin: 0; color: var(--pa-acento-oscuro); }

  .pa-campo { display: grid; gap: 4px; font-weight: 500; font-size: .92rem; }
  .pa-campo input, .pa-campo select, .pa-campo textarea { font: inherit; font-weight: 400; padding: 10px 12px; border: 1.5px solid var(--pa-borde); border-radius: 10px; background: #fff; color: var(--pa-tinta); width: 100%; }
  .pa-campo input:focus, .pa-campo select:focus, .pa-campo textarea:focus { border-color: var(--pa-acento); outline: none; }
  .pa-campo [aria-invalid="true"] { border-color: var(--pa-error); }
  .pa-campo--fila { grid-auto-flow: column; align-items: center; justify-content: start; gap: 8px; }
  .pa-casilla { display: flex; gap: 8px; align-items: center; font-size: .95rem; }
  .pa-casilla input { width: 18px; height: 18px; accent-color: var(--pa-acento); }
  .pa-opciones { border: 0; padding: 0; margin: 0; display: grid; gap: 6px; }
  .pa-opciones legend { font-weight: 500; font-size: .92rem; margin-bottom: 4px; }
  .pa-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pa-error { color: var(--pa-error); font-size: .88rem; margin: 0; }
  .pa-error:empty { display: none; }
  .pa-aviso { background: #fff4d6; border-radius: 10px; padding: 10px 12px; margin: 0; }

  .pa-boton { display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 0; border-radius: 999px; padding: 10px 18px; background: var(--pa-acento); color: #fff; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; }
  .pa-boton:hover { background: var(--pa-acento-oscuro); }
  .pa-boton[disabled] { opacity: .55; cursor: wait; }
  .pa-boton--suave { background: #fff; color: var(--pa-acento-oscuro); border: 1.5px solid var(--pa-borde); }
  .pa-boton--suave:hover { background: #fff; border-color: var(--pa-acento); }
  .pa-boton--peligro { background: var(--pa-error); }
  .pa-boton--chico { padding: 6px 12px; font-size: .88rem; }
  .pa-enlace { background: none; border: 0; color: var(--pa-acento-oscuro); text-decoration: underline; cursor: pointer; font: inherit; }

  .pa-filtros { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
  .pa-lista { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .pa-fila { display: grid; grid-template-columns: 64px 1fr auto; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--pa-borde); border-radius: 14px; padding: 10px 12px; }
  .pa-fila img { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; background: var(--pa-borde); }
  .pa-fila__nombre { font-weight: 600; }
  .pa-fila__datos { color: var(--pa-suave); font-size: .9rem; display: flex; gap: 10px; flex-wrap: wrap; }
  .pa-fila__botones { display: flex; gap: 6px; flex-wrap: wrap; justify-content: end; }
  .pa-etiqueta { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .75rem; font-weight: 600; background: var(--pa-borde); color: var(--pa-tinta); }
  .pa-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .pa-kpi { background: #fff; border: 1px solid var(--pa-borde); border-radius: 14px; padding: 14px 16px; }
  .pa-kpi p { margin: 0; }
  .pa-kpi__titulo { color: var(--pa-suave); font-size: .85rem; font-weight: 500; }
  .pa-kpi__valor { font-size: 1.6rem; font-weight: 600; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .pa-kpi__nota { color: var(--pa-suave); font-size: .85rem; }
  .pa-kpi__nota strong { color: var(--pa-tinta); }
  .pa-panel { background: #fff; border: 1px solid var(--pa-borde); border-radius: 14px; padding: 16px; margin-bottom: 16px; min-width: 0; }
  .pa-columnas { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .pa-columnas .pa-panel { margin-bottom: 0; }
  .pa-grafico { position: relative; }
  .pa-grafico svg { display: block; width: 100%; height: 200px; overflow: visible; }
  .pa-grafico .eje { font-size: 11px; fill: var(--pa-suave); }
  .pa-grafico .rejilla { stroke: var(--pa-borde); stroke-width: 1; }
  .pa-grafico .barra { fill: var(--pa-acento); }
  .pa-grafico .barra--activa { fill: var(--pa-acento-oscuro); }
  .pa-grafico .zona { fill: transparent; cursor: pointer; }
  .pa-grafico__tooltip { position: absolute; top: 0; transform: translateX(-50%); background: var(--pa-tinta); color: #fff; padding: 6px 10px; border-radius: 8px; font-size: .82rem; pointer-events: none; white-space: nowrap; }
  .pa-grafico__tooltip strong { display: block; }
  .pa-tabla-detalle { margin-top: 8px; font-size: .9rem; }
  .pa-tabla-detalle summary { cursor: pointer; color: var(--pa-acento-oscuro); font-weight: 500; }
  .pa-tabla { width: 100%; border-collapse: collapse; margin-top: 8px; font-variant-numeric: tabular-nums; }
  .pa-tabla th, .pa-tabla td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--pa-borde); }
  .pa-tabla td:not(:first-child), .pa-tabla th:not(:first-child) { text-align: right; }
  .pa-ranking { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .pa-ranking--simple { list-style: none; padding-left: 0; }
  .pa-ranking li { display: flex; justify-content: space-between; gap: 12px; font-variant-numeric: tabular-nums; }
  .pa-ranking li span:last-child { color: var(--pa-suave); text-align: right; min-width: 0; }
  .pa-ranking li span:first-child { flex-shrink: 0; }
  .pa-ranking:empty::before { content: "Todavía no hay ventas en este período."; color: var(--pa-suave); }
  .pa-subtitulo { font-size: 1.2rem !important; font-weight: 600 !important; margin: 28px 0 12px !important; }
  .pa-kpis--dos { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .pa-panel__cabeza { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
  .pa-panel__cabeza h2 { margin: 0; }
  .pa-comparar { display: flex; gap: 10px; flex-wrap: wrap; }
  .pa-comparar select { padding: 6px 10px; }
  .pa-leyenda { list-style: none; margin: 8px 0; padding: 0; display: flex; gap: 16px; font-size: .88rem; color: var(--pa-tinta); }
  .pa-leyenda li { display: flex; align-items: center; gap: 6px; }
  .pa-leyenda__muestra { width: 12px; height: 12px; border-radius: 3px; background: var(--pa-acento); }
  .pa-leyenda__muestra--b { background: var(--pa-comparacion); }
  .pa-grafico .barra--b { fill: var(--pa-comparacion); }
  .pa-grafico .barra--tenue { opacity: .35; }
  .pa-periodo { display: grid; gap: 12px; }
