---
/**
 * Pantalla del panel, lista para usar en cualquier sitio:
 *
 *   ---  // src/pages/admin/index.astro
 *   import PanelAdmin from "nucleo-web/panel/PanelAdmin.astro";
 *   ---
 *   <PanelAdmin nombre="Mi Tienda" logo="/img/logo.png" />
 *
 * Toma los colores del sitio con variables CSS (--pa-acento, etc.). Toda
 * la lógica vive en panel-app.ts y en el cliente del módulo. Cumple la CSP
 * del panel: sin estilos ni scripts en línea, nada externo.
 */
interface Props {
  nombre: string;
  logo?: string;
  /** Dirección pública de la tienda, para el botón "Ver tienda". */
  tienda?: string;
  /** Cuántos destacados muestra el inicio (para avisarlo en el panel). */
  maxDestacados?: number;
  /** Colores (hex). Por defecto un rosado sobrio. */
  colores?: { acento?: string; acentoOscuro?: string; fondo?: string; tinta?: string };
  /**
   * Colores de los gráficos (hex), en orden: torta y barras de "Más vendidos"
   * y "Medios de pago" usan los 5; el segundo es el año comparado. Conviene
   * pasarlos por el validador de paletas (daltonismo y contraste) antes de
   * usarlos. Sin esto se usa una paleta neutra ya validada.
   */
  coloresGraficos?: string[];
  /** Muestra la pestaña Portada (el sitio montó el carrusel editable). */
  carrusel?: boolean;
  /** Muestra la pestaña "Diseño y textos" (el sitio montó el contenido editable). */
  contenido?: boolean;
  /** Muestra "Boletines" en Suscriptores (el sitio montó panel.boletines). */
  boletines?: boolean;
  /** Muestra "Revisión de pagos" en Resumen (el sitio montó panel.revisionPagos). */
  revisionPagos?: boolean;
  /** Muestra el cuadro "Despacho" en Pedidos (el sitio montó panel.despacho). */
  despacho?: boolean;
  /** Muestra la pestaña "Mensajes" (el sitio montó panel.mensajes y el formulario de contacto). */
  mensajes?: boolean;
  /** Muestra el interruptor "Sitio en construcción" en Resumen (el sitio montó panel.construccion). */
  construccion?: boolean;
}
import { LIMITES } from "../../carrusel/tipos";
import { LIMITES_CATEGORIA } from "../../catalogo/categorias";
import { LIMITES_BOLETIN } from "../../newsletter/boletin";
const { nombre, logo, tienda = "/", colores = {}, maxDestacados, coloresGraficos = [], carrusel = false, contenido = false, boletines = false, revisionPagos = false, despacho = false, mensajes = false, construccion = false } = Astro.props;
const COLOR = /^#[0-9a-fA-F]{3,8}$/;
const c = (v: string | undefined, d: string) => (v && COLOR.test(v) ? v : d);
const tema = {
  acento: c(colores.acento, "#C2185B"),
  acentoOscuro: c(colores.acentoOscuro, "#9C1449"),
  fondo: c(colores.fondo, "#FBF7F9"),
  tinta: c(colores.tinta, "#221A1F"),
};
const graficos = coloresGraficos.filter((x) => COLOR.test(x)).slice(0, 5).join(",");
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel | {nombre}</title>
  <link rel="icon" href={logo ?? "/favicon.ico"} />
</head>
<body class="pa-cuerpo">
<div
  class="pa"
  data-panel
  data-nombre={nombre}
  data-acento={tema.acento}
  data-acento-oscuro={tema.acentoOscuro}
  data-fondo={tema.fondo}
  data-tinta={tema.tinta}
  data-graficos={graficos || undefined}
  data-max-destacados={maxDestacados}
>
  <a class="pa-saltar" href="#pa-principal">Saltar al contenido</a>

  <header class="pa-cabecera" data-solo-sesion hidden>
    <div class="pa-marca">
      {logo && <img src={logo} alt="" width="40" height="40" />}
      <span><strong>{nombre}</strong><small>Panel de administración</small></span>
    </div>
    <nav class="pa-pestanas" aria-label="Secciones">
      <button type="button" data-tab="resumen" aria-current="page">Resumen</button>
      <button type="button" data-tab="productos">Productos</button>
      <button type="button" data-tab="categorias">Categorías</button>
      <button type="button" data-tab="portada" hidden={!carrusel}>Portada</button>
      <button type="button" data-tab="sitio" hidden={!contenido}>Diseño y textos</button>
      <button type="button" data-tab="pedidos">Pedidos</button>
      <button type="button" data-tab="mensajes" hidden={!mensajes}>Mensajes <span class="pa-burbuja" data-mensajes-pendientes hidden></span></button>
      <button type="button" data-tab="suscriptores">Suscriptores</button>
      <button type="button" data-tab="seguridad">Seguridad</button>
    </nav>
    <div class="pa-acciones">
      <button class="pa-boton pa-boton--suave" type="button" data-ayuda-abrir>? Ayuda</button>
      <a class="pa-boton pa-boton--suave" href={tienda} target="_blank" rel="noopener">Ver tienda ↗</a>
      <button class="pa-boton pa-boton--suave" type="button" data-salir>Salir</button>
    </div>
  </header>

  <p class="pa-banda" data-construccion-banda hidden>
    <span>Tu tienda está en <strong>modo construcción</strong>: los clientes ven el aviso y no pueden comprar.</span>
    <button class="pa-enlace" type="button" data-ir-construccion>Cambiar</button>
  </p>

  <main id="pa-principal" class="pa-principal">
    <!-- ───────────── acceso ───────────── -->
    <section class="pa-vista pa-centro" data-vista="cargando" aria-live="polite">
      <p class="pa-tenue">Cargando el panel…</p>
    </section>

    <section class="pa-vista pa-centro" data-vista="no-disponible" hidden>
      <div class="pa-caja">
        <h1>El panel no está disponible</h1>
        <p data-no-disponible-texto>Falta configuración en el servidor.</p>
      </div>
    </section>

    <section class="pa-vista pa-centro" data-vista="instalar" hidden>
      <form class="pa-caja" data-form="instalar" novalidate>
        {logo && <img class="pa-logo-grande" src={logo} alt="" width="96" height="96" />}
        <h1>Crear tu usuario</h1>
        <p class="pa-tenue">Esto se hace una sola vez. Guarda tu contraseña en un lugar seguro.</p>
        <label class="pa-campo">Usuario<input name="usuario" autocomplete="username" required minlength="3" maxlength="40" /></label>
        <label class="pa-campo">Contraseña (mínimo 10 caracteres)<input name="clave" type="password" autocomplete="new-password" required minlength="10" /></label>
        <label class="pa-campo">Repite la contraseña<input name="repetir" type="password" autocomplete="new-password" required /></label>
        <label class="pa-campo">Clave de instalación<input name="claveInstalacion" type="password" autocomplete="off" required /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Crear usuario</button>
      </form>
    </section>

    <section class="pa-vista pa-centro" data-vista="invitacion" hidden>
      <form class="pa-caja" data-form="invitacion" novalidate>
        {logo && <img class="pa-logo-grande" src={logo} alt="" width="96" height="96" />}
        <h1>Te invitaron al panel</h1>
        <p class="pa-tenue">Elige tu usuario y tu contraseña. Este enlace sirve una sola vez.</p>
        <label class="pa-campo">Usuario<input name="usuario" autocomplete="username" required minlength="3" maxlength="40" /></label>
        <p class="pa-tenue pa-chico">Letras, números, punto o guion, sin espacios. Ejemplo: sasha</p>
        <label class="pa-campo">Contraseña (mínimo 10 caracteres)<input name="clave" type="password" autocomplete="new-password" required minlength="10" /></label>
        <label class="pa-campo">Repite la contraseña<input name="repetir" type="password" autocomplete="new-password" required /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Crear mi usuario</button>
      </form>
    </section>

    <section class="pa-vista pa-centro" data-vista="invitacion-vencida" hidden>
      <div class="pa-caja">
        <h1>Este enlace ya no sirve</h1>
        <p>Se usó o venció. Pide uno nuevo a quien te invitó.</p>
        <button class="pa-enlace" type="button" data-ir-entrar>Ya tengo usuario: entrar</button>
      </div>
    </section>

    <section class="pa-vista pa-centro" data-vista="entrar" hidden>
      <form class="pa-caja" data-form="entrar" novalidate>
        {logo && <img class="pa-logo-grande" src={logo} alt="" width="96" height="96" />}
        <h1>Entrar al panel</h1>
        <p class="pa-aviso" data-aviso-entrar hidden></p>
        <label class="pa-campo">Usuario<input name="usuario" autocomplete="username" required /></label>
        <label class="pa-campo">Contraseña<input name="clave" type="password" autocomplete="current-password" required /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Entrar</button>
      </form>
    </section>

    <section class="pa-vista pa-centro" data-vista="codigo" hidden>
      <form class="pa-caja" data-form="codigo" novalidate>
        <h1>Código de verificación</h1>
        <p class="pa-tenue">Escribe los 6 dígitos de tu app autenticadora, o uno de tus códigos de respaldo.</p>
        <label class="pa-campo">Código<input name="codigo" inputmode="numeric" autocomplete="one-time-code" required maxlength="11" /></label>
        <p class="pa-error" role="alert" data-error></p>
        <button class="pa-boton" type="submit">Verificar</button>
        <button class="pa-enlace" type="button" data-volver-entrar>Volver</button>
      </form>
    </section>

    <!-- ───────────── productos ───────────── -->
    <section class="pa-vista" data-vista="productos" hidden>
      <div class="pa-titulo">
        <h1>Productos</h1>
        <button class="pa-boton" type="button" data-nuevo-producto>+ Nuevo producto</button>
      </div>
      <div class="pa-aviso-fotos" data-productos-sitio hidden>
        <p><strong data-productos-sitio-texto></strong> <span data-productos-sitio-nombres></span> Se agregan tal como vienen preparados; tus productos no cambian.</p>
        <span class="pa-fila__botones">
          <button class="pa-boton" type="button" data-productos-sitio-agregar>Agregar a la tienda</button>
          <button class="pa-boton pa-boton--suave" type="button" data-productos-sitio-descartar>No agregar</button>
        </span>
      </div>
      <div class="pa-aviso-fotos" data-fotos-sitio-todos hidden>
        <p><strong data-fotos-sitio-todos-texto></strong> Se usan sin tocar tus unidades, nombres, precios ni las fotos que tú subiste.</p>
        <button class="pa-boton pa-boton--suave" type="button" data-fotos-sitio-todos-usar>Usar las fotos preparadas</button>
      </div>
      <div class="pa-filtros">
        <label class="pa-campo pa-campo--fila">Buscar<input type="search" data-buscar-producto placeholder="Nombre…" /></label>
        <label class="pa-campo pa-campo--fila">Categoría<select data-filtro-categoria><option value="">Todas</option></select></label>
      </div>
      <details class="pa-caja pa-caja--ancha pa-ficha-ajustes" data-ficha-ajustes>
        <summary><strong>Cómo se ve la ficha del producto</strong> <span class="pa-tenue pa-chico">(miniaturas de colores y partes opcionales)</span></summary>
        <form data-form="ficha-ajustes" novalidate>
          <fieldset class="pa-opciones">
            <legend>Miniaturas de los colores</legend>
            <label class="pa-casilla"><input type="radio" name="miniatura" value="completa" /> <span><strong>Foto completa</strong> · se ve el producto entero</span></label>
            <label class="pa-casilla"><input type="radio" name="miniatura" value="acercamiento" /> <span><strong>Acercamiento</strong> · de cerca, para ver la textura (el punto se ajusta en cada producto)</span></label>
          </fieldset>
          <fieldset class="pa-opciones">
            <legend>Mostrar en la ficha</legend>
            <label class="pa-casilla"><input type="checkbox" name="categoria" /> La categoría sobre el nombre</label>
            <label class="pa-casilla"><input type="checkbox" name="disponible" /> «Disponible», «¡Quedan 2!» o «Agotado» junto al precio</label>
            <label class="pa-casilla"><input type="checkbox" name="cuentaColores" /> Cuántos colores hay («12 colores»)</label>
            <label class="pa-casilla"><input type="checkbox" name="lupa" /> La lupa para ver la foto en pantalla completa</label>
            <label class="pa-casilla"><input type="checkbox" name="confianza" /> Los recuadros de envío, pago seguro y atención</label>
          </fieldset>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Guardar</button>
        </form>
      </details>
      <details class="pa-caja pa-caja--ancha pa-ficha-ajustes" data-vista-listas>
        <summary><strong>Cómo se ven en la tienda los productos con colores</strong> <span class="pa-tenue pa-chico">(una tarjeta por producto o una por color)</span></summary>
        <form data-form="vista-listas" novalidate>
          <fieldset class="pa-opciones">
            <legend>En la página de cada categoría</legend>
            <label class="pa-casilla"><input type="radio" name="categorias" value="producto" /> <span><strong>Una tarjeta por producto</strong> · con sus colores en circulitos bajo la foto</span></label>
            <label class="pa-casilla"><input type="radio" name="categorias" value="color" /> <span><strong>Una tarjeta por color</strong> · la página se ve llena aunque haya pocos productos</span></label>
          </fieldset>
          <fieldset class="pa-opciones">
            <legend>En toda la tienda, el inicio y «También te puede gustar»</legend>
            <label class="pa-casilla"><input type="radio" name="general" value="producto" /> <span><strong>Una tarjeta por producto</strong> · con sus colores en circulitos bajo la foto</span></label>
            <label class="pa-casilla"><input type="radio" name="general" value="color" /> <span><strong>Una tarjeta por color</strong> · ojo: con muchos colores la lista se hace muy larga</span></label>
          </fieldset>
          <p class="pa-tenue pa-chico">Los productos sin colores se ven siempre igual. El cambio se ve en la tienda en menos de un minuto.</p>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Guardar</button>
        </form>
      </details>
      <p class="pa-tenue" data-resumen-productos></p>
      <ul class="pa-lista" data-lista-productos aria-live="polite"></ul>
    </section>

    <!-- ───────────── categorías ───────────── -->
    <section class="pa-vista" data-vista="categorias" hidden>
      <div class="pa-titulo">
        <h1>Categorías</h1>
        <button class="pa-boton" type="button" data-nueva-categoria>Nueva categoría</button>
      </div>
      <p class="pa-tenue">Crea, edita o borra categorías. Los cambios se ven en el menú, el inicio y la tienda en unos segundos. Solo se puede borrar una categoría sin productos.</p>
      <p class="pa-tenue pa-chico" data-cupo-categorias></p>
      <ul class="pa-lista" data-lista-categorias aria-live="polite"></ul>
      <button class="pa-enlace" type="button" data-restablecer-categorias hidden>Volver a los nombres y fotos originales</button>
    </section>

    <!-- ───────────── diseño y textos (contenido) ───────────── -->
    <section class="pa-vista" data-vista="sitio" hidden>
      <div class="pa-titulo">
        <h1>Diseño y textos</h1>
        <a class="pa-boton pa-boton--suave" href={tienda} target="_blank" rel="noopener">Ver tienda ↗</a>
      </div>
      <p class="pa-tenue">Elige una sección, cambia lo que quieras y pulsa <strong>Guardar cambios</strong>. El sitio se actualiza en unos segundos.</p>
      <div class="pa-secciones" role="group" aria-label="Secciones" data-sitio-grupos></div>
      <form class="pa-panel pa-sitio" data-form="sitio" novalidate>
        <h2 data-sitio-titulo></h2>
        <p class="pa-tenue" data-sitio-descripcion></p>
        <div data-sitio-extra></div>
        <div class="pa-sitio__campos" data-sitio-campos></div>
        <p class="pa-error" role="alert" data-error></p>
        <div class="pa-sitio__pie">
          <button class="pa-enlace" type="button" data-sitio-restablecer>Volver a lo original en esta sección</button>
          <button class="pa-boton" type="submit">Guardar cambios</button>
        </div>
      </form>
    </section>

    <!-- ───────────── portada (carrusel) ───────────── -->
    <section class="pa-vista" data-vista="portada" hidden>
      <div class="pa-titulo">
        <h1>Portada</h1>
        <div class="pa-fila__botones">
          <a class="pa-boton pa-boton--suave" href={tienda} target="_blank" rel="noopener">Ver portada ↗</a>
          <button class="pa-boton" type="button" data-nueva-diapo>+ Nueva diapositiva</button>
        </div>
      </div>
      <p class="pa-tenue">Las fotos grandes del inicio de la tienda. Se muestran en este orden y los cambios se ven en unos segundos.</p>
      <div class="pa-panel pa-portada-ajustes">
        <label class="pa-casilla"><input type="checkbox" data-carrusel-automatico /> Avanzar solas</label>
        <label class="pa-campo pa-campo--fila">Cambiar cada<select data-carrusel-segundos></select></label>
        <label class="pa-campo pa-campo--fila">Botones
          <select data-carrusel-controles>
            <option value="burbuja">Cápsula blanca (pausa, flechas y puntos)</option>
            <option value="minimo">Mínimo (puntos blancos; flechas al pasar el mouse)</option>
            <option value="lineas">Líneas finas de progreso</option>
            <option value="discreto">Discreto (solo pausa)</option>
          </select>
        </label>
        <p class="pa-tenue pa-chico">Siempre se pueden pausar. No avanzan solas si la persona pidió "reducir movimiento" en su teléfono o computador.</p>
      </div>
      <ul class="pa-lista" data-lista-diapos aria-live="polite"></ul>
      <p class="pa-tenue pa-chico" data-portada-estado></p>
      <button class="pa-enlace" type="button" data-restablecer-portada hidden>Volver a la portada original del sitio</button>
    </section>

    <!-- ───────────── resumen (métricas) ───────────── -->
    <section class="pa-vista" data-vista="resumen" hidden>
      <div class="pa-titulo">
        <h1>Resumen</h1>
        <button class="pa-boton pa-boton--suave pa-boton--chico" type="button" data-resumen-recargar>Actualizar</button>
      </div>
      <p class="pa-aviso pa-aviso--despacho" data-resumen-despacho hidden>
        <span data-resumen-despacho-texto></span>
        <button class="pa-enlace" type="button" data-ir-pedidos>Ver pedidos</button>
      </p>
      <div class="pa-kpis">
        <div class="pa-kpi"><p class="pa-kpi__titulo">Ventas de hoy</p><p class="pa-kpi__valor" data-kpi="hoy">—</p><p class="pa-kpi__nota" data-kpi-nota="hoy"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Últimos 7 días</p><p class="pa-kpi__valor" data-kpi="d7">—</p><p class="pa-kpi__nota" data-kpi-nota="d7"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Últimos 30 días</p><p class="pa-kpi__valor" data-kpi="d30">—</p><p class="pa-kpi__nota" data-kpi-nota="d30"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Venta promedio</p><p class="pa-kpi__valor" data-kpi="ticket">—</p><p class="pa-kpi__nota">por pedido, últimos 30 días</p></div>
      </div>
      <div class="pa-revision" data-construccion hidden={!construccion}>
        <h2 class="pa-subtitulo">Estado de la tienda</h2>
        <div class="pa-revision__estado" data-construccion-estado role="status">
          <p class="pa-revision__titulo" data-construccion-titulo>—</p>
          <p class="pa-tenue pa-chico" data-construccion-detalle></p>
          <label class="pa-campo" data-construccion-clave-caja hidden>Tu clave para abrir o cerrar la tienda<input type="password" autocomplete="off" maxlength="200" data-construccion-clave /></label>
          <button class="pa-boton pa-boton--suave" type="button" data-construccion-boton hidden></button>
          <details class="pa-chico" data-construccion-activar hidden>
            <summary>¿El dueño del panel te dio un código para abrir y cerrar la tienda?</summary>
            <form data-form="activar-construccion" novalidate>
              <label class="pa-campo">Código<input name="codigo" autocomplete="off" maxlength="20" autocapitalize="characters" required /></label>
              <label class="pa-campo">Crea tu clave (mínimo 8 caracteres)<input name="nueva" type="password" autocomplete="new-password" minlength="8" maxlength="200" required /></label>
              <label class="pa-campo">Repite tu clave<input name="repetir" type="password" autocomplete="new-password" required /></label>
              <p class="pa-error" role="alert" data-error></p>
              <button class="pa-boton" type="submit">Activar</button>
            </form>
          </details>
        </div>
      </div>
      <div class="pa-revision" data-revision hidden={!revisionPagos}>
        <div class="pa-titulo-seccion">
          <h2 class="pa-subtitulo">Revisión de pagos</h2>
          <button class="pa-boton pa-boton--suave pa-boton--chico" type="button" data-revision-ahora>Revisar ahora</button>
        </div>
        <div class="pa-revision__estado" data-revision-estado role="status">
          <p class="pa-revision__titulo" data-revision-titulo>—</p>
          <p class="pa-tenue pa-chico" data-revision-detalle></p>
        </div>
        <ul class="pa-lista" data-revision-errores hidden></ul>
        <ul class="pa-lista" data-revision-alertas></ul>
        <p class="pa-tenue pa-chico">Compara lo que cobró Flow en los últimos días con los pedidos de la tienda. Las devoluciones no aparecen aquí: revísalas una vez por semana en tu cuenta de Flow → Reembolsos.</p>
      </div>
      <div class="pa-titulo-seccion">
        <h2 class="pa-subtitulo">Visitas</h2>
        <div class="pa-segmento" role="group" aria-label="Período de visitas" data-visitas-periodo>
          <button type="button" data-dias="7">7 días</button>
          <button type="button" data-dias="30">30 días</button>
        </div>
      </div>
      <p class="pa-aviso" data-visitas-aviso hidden></p>
      <div data-visitas-datos hidden>
        <div class="pa-kpis">
          <div class="pa-kpi"><p class="pa-kpi__titulo">Visitas</p><p class="pa-kpi__valor" data-kpi="visitas">—</p><p class="pa-kpi__nota">personas que llegaron a la tienda</p></div>
          <div class="pa-kpi"><p class="pa-kpi__titulo">Páginas vistas</p><p class="pa-kpi__valor" data-kpi="paginas">—</p><p class="pa-kpi__nota" data-kpi-nota="paginas"></p></div>
          <div class="pa-kpi"><p class="pa-kpi__titulo">Compran</p><p class="pa-kpi__valor" data-kpi="conversion">—</p><p class="pa-kpi__nota" data-kpi-nota="conversion"></p></div>
        </div>
        <div class="pa-panel">
          <h2>Visitas por día</h2>
          <div class="pa-grafico">
            <svg data-visitas-svg viewBox="0 0 640 200" role="img" aria-label="Visitas por día"></svg>
            <div class="pa-grafico__tooltip" data-visitas-tooltip role="status" hidden></div>
          </div>
        </div>
        <div class="pa-columnas">
          <div class="pa-panel"><h2>Páginas más vistas</h2><div class="pa-partes" data-visitas-paginas></div></div>
          <div class="pa-panel"><h2>De dónde llegan</h2><div class="pa-partes" data-visitas-origenes></div></div>
          <div class="pa-panel"><h2>Países</h2><div class="pa-partes" data-visitas-paises></div></div>
          <div class="pa-panel"><h2>Dispositivos</h2><div class="pa-partes" data-visitas-dispositivos></div></div>
        </div>
        <p class="pa-tenue pa-chico" data-visitas-nota></p>
      </div>

      <h2 class="pa-subtitulo">Explorar ventas</h2>
      <form class="pa-panel pa-periodo" data-form-periodo>
        <div class="pa-periodo__atajos" role="group" aria-label="Períodos rápidos">
          <button type="button" class="pa-chip" data-atajo="7">7 días</button>
          <button type="button" class="pa-chip" data-atajo="30">30 días</button>
          <button type="button" class="pa-chip" data-atajo="este-mes">Este mes</button>
          <button type="button" class="pa-chip" data-atajo="mes-pasado">Mes pasado</button>
          <button type="button" class="pa-chip" data-atajo="este-anio">Este año</button>
          <button type="button" class="pa-chip" data-atajo="anio-pasado">Año pasado</button>
        </div>
        <div class="pa-periodo__campos">
          <label class="pa-campo">Desde<input type="date" name="desde" required /></label>
          <label class="pa-campo">Hasta<input type="date" name="hasta" required /></label>
          <label class="pa-campo">Agrupar por<select name="agrupar"><option value="dia">Día</option><option value="semana">Semana</option><option value="mes">Mes</option></select></label>
          <button class="pa-boton" type="submit">Ver</button>
        </div>
        <p class="pa-error" role="alert" data-error-periodo></p>
      </form>
      <p class="pa-aviso" data-periodo-aproximado hidden></p>
      <div class="pa-kpis">
        <div class="pa-kpi"><p class="pa-kpi__titulo">Ventas del período</p><p class="pa-kpi__valor" data-kpi="rango">—</p><p class="pa-kpi__nota" data-kpi-nota="rango"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Pedidos</p><p class="pa-kpi__valor" data-kpi="rango-pedidos">—</p><p class="pa-kpi__nota" data-kpi-nota="rango-pedidos"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Venta promedio</p><p class="pa-kpi__valor" data-kpi="rango-ticket">—</p><p class="pa-kpi__nota">por pedido en el período</p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo">Período anterior</p><p class="pa-kpi__valor" data-kpi="rango-anterior">—</p><p class="pa-kpi__nota" data-kpi-nota="rango-anterior"></p></div>
      </div>
      <div class="pa-panel">
        <div class="pa-panel__cabeza">
          <h2 data-titulo-serie>Ventas en el período</h2>
          <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="tiempo">
            <button type="button" data-tipo="barras">Barras</button>
            <button type="button" data-tipo="linea">Línea</button>
          </div>
        </div>
        <div class="pa-grafico">
          <svg data-grafico-svg viewBox="0 0 640 200" role="img" aria-label="Ventas en el período"></svg>
          <div class="pa-grafico__tooltip" data-grafico-tooltip role="status" hidden></div>
        </div>
        <details class="pa-tabla-detalle">
          <summary>Ver como tabla</summary>
          <table class="pa-tabla"><thead><tr><th scope="col">Período</th><th scope="col">Pedidos</th><th scope="col">Ventas</th></tr></thead><tbody data-tabla-ventas></tbody></table>
        </details>
      </div>
      <div class="pa-columnas">
        <div class="pa-panel">
          <div class="pa-panel__cabeza">
            <h2>Más vendidos</h2>
            <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="productos">
              <button type="button" data-tipo="lista">Lista</button>
              <button type="button" data-tipo="barras">Barras</button>
              <button type="button" data-tipo="torta">Torta</button>
            </div>
          </div>
          <div class="pa-partes" data-top-productos></div>
        </div>
        <div class="pa-panel">
          <div class="pa-panel__cabeza">
            <h2>Medios de pago</h2>
            <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="medios">
              <button type="button" data-tipo="lista">Lista</button>
              <button type="button" data-tipo="barras">Barras</button>
              <button type="button" data-tipo="torta">Torta</button>
            </div>
          </div>
          <div class="pa-partes" data-medios></div>
        </div>
      </div>
      <h2 class="pa-subtitulo">Comparación por años</h2>
      <div class="pa-kpis pa-kpis--dos">
        <div class="pa-kpi"><p class="pa-kpi__titulo" data-kpi-anio-titulo>Este año a la fecha</p><p class="pa-kpi__valor" data-kpi="anio">—</p><p class="pa-kpi__nota" data-kpi-nota="anio"></p></div>
        <div class="pa-kpi"><p class="pa-kpi__titulo" data-kpi-anio-anterior-titulo>Año anterior a la misma fecha</p><p class="pa-kpi__valor" data-kpi="anio-anterior">—</p><p class="pa-kpi__nota" data-kpi-nota="anio-anterior"></p></div>
      </div>
      <div class="pa-panel">
        <div class="pa-panel__cabeza">
          <h2>Ventas por mes</h2>
          <div class="pa-segmento" role="group" aria-label="Tipo de gráfico" data-tipo-grafico="anios">
            <button type="button" data-tipo="barras">Barras</button>
            <button type="button" data-tipo="linea">Línea</button>
          </div>
          <div class="pa-comparar">
            <label class="pa-campo pa-campo--fila">Comparar<select data-anio-a aria-label="Año principal"></select></label>
            <label class="pa-campo pa-campo--fila">con<select data-anio-b aria-label="Año a comparar"></select></label>
          </div>
        </div>
        <ul class="pa-leyenda" aria-label="Leyenda">
          <li><span class="pa-leyenda__muestra"></span><span data-leyenda-a></span></li>
          <li><span class="pa-leyenda__muestra pa-leyenda__muestra--b"></span><span data-leyenda-b></span></li>
        </ul>
        <div class="pa-grafico">
          <svg data-comparacion-svg viewBox="0 0 640 200" role="img" aria-label="Ventas por mes de dos años"></svg>
          <div class="pa-grafico__tooltip" data-comparacion-tooltip role="status" hidden></div>
        </div>
        <details class="pa-tabla-detalle">
          <summary>Ver como tabla</summary>
          <table class="pa-tabla"><thead><tr><th scope="col">Mes</th><th scope="col" data-th-a></th><th scope="col" data-th-b></th><th scope="col">Variación</th></tr></thead><tbody data-tabla-comparacion></tbody></table>
        </details>
      </div>
      <div class="pa-panel">
        <h2>Historial por año</h2>
        <div class="pa-partes" data-historial-anios></div>
      </div>
      <p class="pa-tenue pa-chico">Las visitas al sitio (cuántas personas entran y desde dónde) se ven en Cloudflare → Web Analytics.</p>
    </section>

    <!-- ───────────── pedidos ───────────── -->
    <section class="pa-vista" data-vista="pedidos" hidden>
      <div class="pa-titulo">
        <h1>Pedidos</h1>
        <label class="pa-casilla"><input type="checkbox" data-pedidos-todos /> Ver también los no pagados</label>
      </div>
      <details class="pa-caja pa-caja--ancha pa-despacho" data-despacho-caja hidden={!despacho}>
        <summary><h2>Despacho</h2> <span class="pa-tenue" data-despacho-resumen></span></summary>
        <p class="pa-tenue">Cómo se cobra el despacho de los productos físicos. Los cursos y patrones nunca pagan despacho.</p>
        <form data-form="despacho" novalidate>
          <fieldset class="pa-opciones">
            <label class="pa-casilla"><input type="checkbox" name="pagarAhora" /> <strong>Cobrar el despacho según la zona</strong></label>
            <p class="pa-tenue pa-chico">Encendido: se cobra según la zona; en las zonas que marques abajo el comprador también puede elegir pagarlo al recibir. Apagado: todo es “por pagar” al recibir.</p>
          </fieldset>

          <div data-despacho-tarifas class="pa-despacho__tarifas">
            <section class="pa-despacho__bloque">
              <h3>Región Metropolitana</h3>
              <div class="pa-grilla-2">
                <label class="pa-campo">Zona centro<input name="centro" inputmode="numeric" autocomplete="off" placeholder="Ej: 3.500" /></label>
                <label class="pa-campo">Zona alejada<input name="alejada" inputmode="numeric" autocomplete="off" placeholder="Ej: 5.000" /></label>
              </div>
              <details class="pa-despacho__lista">
                <summary>Comunas de la <strong>zona centro</strong>: <span data-cuenta-comunas></span> <span class="pa-tenue">(las que no marques son zona alejada)</span></summary>
                <input type="search" class="pa-despacho__buscar" data-buscar-comuna placeholder="Buscar comuna…" aria-label="Buscar comuna" />
                <label class="pa-casilla pa-casilla--todas"><input type="checkbox" data-todas="comunas" /> Seleccionar todas</label>
                <div class="pa-despacho__casillas" data-casillas-comunas></div>
              </details>
            </section>

            <section class="pa-despacho__bloque">
              <h3>Regiones</h3>
              <div class="pa-grilla-2">
                <label class="pa-campo">Zona cercana<input name="cercana" inputmode="numeric" autocomplete="off" placeholder="Ej: 5.500" /></label>
                <label class="pa-campo">Zona extrema<input name="extrema" inputmode="numeric" autocomplete="off" placeholder="Ej: 7.000" /></label>
              </div>
              <details class="pa-despacho__lista">
                <summary>Regiones de la <strong>zona cercana</strong>: <span data-cuenta-regiones></span> <span class="pa-tenue">(las que no marques son zona extrema)</span></summary>
                <label class="pa-casilla pa-casilla--todas"><input type="checkbox" data-todas="regiones" /> Seleccionar todas</label>
                <div class="pa-despacho__casillas" data-casillas-regiones></div>
              </details>
            </section>

            <label class="pa-campo">Despacho gratis en compras desde (opcional)<input name="gratisDesde" inputmode="numeric" autocomplete="off" placeholder="Ej: 30.000 — vacío si no lo usas" /></label>
            <p class="pa-tenue pa-chico">Pon 0 en una zona para que ahí sea gratis.</p>
            <label class="pa-casilla"><input type="checkbox" name="mostrarValores" /> Mostrar los valores del despacho en la tienda (producto, carrito y Términos)</label>
            <p class="pa-tenue pa-chico">Desmarcado, no se publican los valores por zona: el comprador ve el valor de su despacho recién en el carrito, al elegir su región y comuna, sumado al total antes de pagar.</p>

            <section class="pa-despacho__bloque">
              <h3>Pagar el despacho al recibir</h3>
              <p class="pa-tenue pa-chico">Marca las zonas donde el comprador puede elegir pagar el despacho al recibir. En las que no marques, se paga siempre junto con la compra (por ejemplo, si el courier de Santiago lo exige pagado).</p>
              <div class="pa-despacho__casillas" data-casillas-alrecibir></div>
            </section>
          </div>

          <section class="pa-despacho__bloque" data-retiro>
            <h3>Retiro sin costo</h3>
            <label class="pa-casilla"><input type="checkbox" name="retiroActivo" /> <strong>Ofrecer retiro sin costo</strong></label>
            <p class="pa-tenue pa-chico">En el carrito aparece como otra opción de entrega: no se cobra despacho y no se pide la dirección del comprador. Sirve aunque no tengas tienda física.</p>
            <div class="pa-despacho__retiro" data-retiro-campos>
              <label class="pa-campo">Nombre que se ve en la tienda<select name="retiroNombre" data-retiro-nombres></select></label>
              <label class="pa-campo">Comuna (se ve en la tienda)<input name="retiroComuna" maxlength="60" autocomplete="off" placeholder="Ej: Maipú" /></label>
              <label class="pa-campo">Dirección o punto exacto<input name="retiroDireccion" maxlength="140" autocomplete="off" placeholder="Ej: Metro Plaza de Maipú, salida norte" /></label>
              <label class="pa-casilla"><input type="checkbox" name="retiroSoloCorreo" /> Mostrar la dirección solo en el correo de confirmación (después de pagar)</label>
              <p class="pa-tenue pa-chico">Marcado, en la tienda solo se ve la comuna y la dirección exacta le llega al comprador en el correo, cuando ya pagó. Desmárcalo si quieres que también se vea en el carrito.</p>
              <label class="pa-campo">Instrucciones (opcional)<textarea name="retiroInstrucciones" maxlength="300" rows="2" placeholder="Ej: Te escribiremos por WhatsApp para acordar el día y la hora."></textarea></label>
            </div>
          </section>

          <div class="pa-aviso">
            <strong>Así se verá en la tienda</strong>
            <p class="pa-chico">La ficha de cada producto y el carrito se actualizan solos.</p>
            <p class="pa-chico" data-despacho-vista-corto></p>
            <p class="pa-chico" data-despacho-vista-ficha></p>
            <p class="pa-chico" data-despacho-vista-detalle></p>
          </div>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Guardar cambios</button>
        </form>
      </details>
      <p class="pa-tenue" data-resumen-pedidos></p>
      <ul class="pa-lista" data-lista-pedidos aria-live="polite"></ul>
    </section>

    <!-- ───────────── mensajes ───────────── -->
    <section class="pa-vista" data-vista="mensajes" hidden>
      <div class="pa-titulo"><h1>Mensajes</h1></div>
      <p class="pa-tenue">Lo que te escriben desde el formulario de la página Contacto. Cada mensaje también te llega por correo; para contestar, usa <strong>Responder por correo</strong> (o responde ese correo) y después márcalo como respondido.</p>
      <label class="pa-casilla"><input type="checkbox" data-mensajes-todos /> Ver también los ya respondidos</label>
      <p class="pa-tenue" data-resumen-mensajes></p>
      <ul class="pa-lista" data-lista-mensajes aria-live="polite"></ul>
    </section>

    <!-- ───────────── suscriptores ───────────── -->
    <section class="pa-vista" data-vista="suscriptores" hidden>
      <div class="pa-titulo"><h1>Suscriptores del newsletter</h1></div>
      <div class="pa-caja pa-caja--ancha">
        <p class="pa-numero" data-total-suscriptores>—</p>
        <p class="pa-tenue">personas confirmaron su suscripción.</p>
        <button class="pa-boton" type="button" data-descargar-csv>Descargar lista (CSV)</button>
        <p class="pa-tenue pa-chico">Un respaldo de la lista para abrir en Excel. Para escribirles, usa Boletines aquí abajo.</p>
      </div>
      <div class="pa-caja pa-caja--ancha" data-boletines hidden={!boletines}>
        <div class="pa-titulo pa-titulo--caja">
          <h2>Boletines</h2>
          <button class="pa-boton pa-boton--chico" type="button" data-nuevo-boletin>Nuevo boletín</button>
        </div>
        <p class="pa-tenue pa-chico">Escribe un correo para tus suscriptores. Antes de enviarlo a todos, mándate una prueba para ver cómo se ve. Cada correo lleva solo su enlace para darse de baja.</p>
        <p class="pa-aviso" data-boletin-aviso hidden></p>
        <div class="pa-cupo">
          <p class="pa-cupo__hoy" data-cupo-hoy>—</p>
          <div class="pa-barra" aria-hidden="true"><span data-cupo-barra></span></div>
          <form class="pa-cupo__form" data-form="cupo" novalidate>
            <label class="pa-campo pa-campo--fila">Correos de boletín por día<input type="number" name="porDia" min="1" max="1000" step="1" inputmode="numeric" required /></label>
            <button class="pa-boton pa-boton--suave pa-boton--chico" type="submit">Guardar cambios</button>
          </form>
          <p class="pa-error" role="alert" data-error></p>
          <p class="pa-tenue pa-chico" data-cupo-ayuda></p>
        </div>
        <ul class="pa-lista" data-lista-boletines aria-live="polite"></ul>
        <p class="pa-tenue pa-chico" data-nota-boletines hidden></p>
      </div>
      <div class="pa-caja pa-caja--ancha">
        <h2>Lista</h2>
        <p class="pa-tenue pa-chico">Si alguien te pide que ya no le lleguen correos, búscalo y presiona <strong>Quitar</strong>.</p>
        <label class="pa-campo pa-campo--fila">Buscar<input type="search" data-buscar-suscriptor placeholder="correo@…" autocomplete="off" /></label>
        <ul class="pa-lista" data-lista-suscriptores aria-live="polite"></ul>
        <p class="pa-tenue pa-chico" data-nota-suscriptores hidden></p>
      </div>
    </section>

    <!-- ───────────── seguridad ───────────── -->
    <section class="pa-vista" data-vista="seguridad" hidden>
      <div class="pa-titulo"><h1>Seguridad</h1></div>

      <div class="pa-caja pa-caja--ancha">
        <h2>Doble factor</h2>
        <p data-estado-2fa class="pa-tenue">—</p>
        <div data-2fa-apagado hidden>
          <p>Con el doble factor, además de tu contraseña se pide un código de tu teléfono. Es la mejor protección para tu tienda.</p>
          <button class="pa-boton" type="button" data-2fa-proponer>Activar doble factor</button>
          <div data-2fa-propuesta hidden class="pa-propuesta">
            <ol>
              <li>Instala una app autenticadora (Google Authenticator, Microsoft Authenticator o similar).</li>
              <li>Escanea este código con la app:</li>
            </ol>
            <img data-2fa-qr alt="Código QR para configurar el doble factor" width="200" height="200" />
            <p class="pa-tenue pa-chico">¿No puedes escanear? Escribe esta clave en la app: <code data-2fa-secreto></code></p>
            <form data-form="2fa-activar" novalidate>
              <label class="pa-campo">Escribe el código de 6 dígitos que muestra la app<input name="codigo" inputmode="numeric" maxlength="6" required /></label>
              <p class="pa-error" role="alert" data-error></p>
              <button class="pa-boton" type="submit">Confirmar y activar</button>
            </form>
          </div>
        </div>
        <div data-2fa-encendido hidden>
          <form data-form="2fa-respaldos" class="pa-en-linea" novalidate>
            <label class="pa-campo">Código actual<input name="codigo" inputmode="numeric" maxlength="11" required /></label>
            <button class="pa-boton pa-boton--suave" type="submit">Generar códigos de respaldo nuevos</button>
            <p class="pa-error" role="alert" data-error></p>
          </form>
          <details class="pa-detalles">
            <summary>Desactivar el doble factor</summary>
            <form data-form="2fa-desactivar" novalidate>
              <label class="pa-campo">Tu contraseña<input name="clave" type="password" autocomplete="current-password" required /></label>
              <label class="pa-campo">Código actual<input name="codigo" inputmode="numeric" maxlength="11" required /></label>
              <p class="pa-error" role="alert" data-error></p>
              <button class="pa-boton pa-boton--peligro" type="submit">Desactivar</button>
            </form>
          </details>
        </div>
        <div data-respaldos hidden class="pa-respaldos">
          <p><strong>Guarda estos códigos de respaldo.</strong> Cada uno sirve una sola vez si pierdes tu teléfono. No se volverán a mostrar.</p>
          <ul data-lista-respaldos></ul>
          <button class="pa-boton" type="button" data-respaldos-listo>Ya los guardé</button>
        </div>
      </div>

      <div class="pa-caja pa-caja--ancha">
        <h2>Cambiar contraseña</h2>
        <form data-form="clave" novalidate>
          <label class="pa-campo">Contraseña actual<input name="actual" type="password" autocomplete="current-password" required /></label>
          <label class="pa-campo">Contraseña nueva (mínimo 10 caracteres)<input name="nueva" type="password" autocomplete="new-password" required minlength="10" /></label>
          <label class="pa-campo">Repite la nueva<input name="repetir" type="password" autocomplete="new-password" required /></label>
          <label class="pa-campo" data-si-2fa hidden>Código de tu app<input name="codigo" inputmode="numeric" maxlength="11" /></label>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Cambiar contraseña</button>
        </form>
      </div>

      <div class="pa-caja pa-caja--ancha" data-usuarios-caja hidden>
        <h2>Usuarios del panel</h2>
        <p class="pa-tenue">Para darle acceso a alguien sin pasarle tu contraseña: crea un enlace y mándaselo. Sirve una sola vez y vence solo.</p>
        <ul class="pa-lista" data-lista-usuarios></ul>

        <h3 class="pa-subtitulo">Invitar a alguien</h3>
        <form data-form="invitar" novalidate>
          <label class="pa-campo pa-campo--fila">El enlace vence en
            <select name="horas" data-vigencia></select>
          </label>
          <label class="pa-campo">Tu contraseña<input name="clave" type="password" autocomplete="current-password" required /></label>
          <label class="pa-campo" data-si-2fa hidden>Código de tu app<input name="codigo" inputmode="numeric" maxlength="11" /></label>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Crear enlace</button>
        </form>
        <div class="pa-respaldos" data-enlace-invitacion hidden>
          <p><strong>Copia este enlace y mándaselo.</strong> No se volverá a mostrar. Sirve una sola vez; vence <span data-enlace-vence></span>.</p>
          <input class="pa-enlace-copiar" data-enlace-texto readonly aria-label="Enlace de invitación" />
          <div class="pa-fila__botones">
            <button class="pa-boton" type="button" data-enlace-copiar>Copiar enlace</button>
            <button class="pa-boton pa-boton--suave" type="button" data-enlace-listo>Listo</button>
          </div>
        </div>

        <div data-invitaciones-caja hidden>
          <h3 class="pa-subtitulo">Enlaces sin usar</h3>
          <ul class="pa-lista" data-lista-invitaciones></ul>
        </div>
      </div>

      <div class="pa-caja pa-caja--ancha" data-clave-construccion-caja hidden>
        <h2>Abrir y cerrar la tienda</h2>
        <p class="pa-tenue">Tú abres y cierras la tienda sin clave. Para que otra persona del panel pueda hacerlo, crea un código y dáselo: sirve una sola vez y vence solo. Al usarlo, esa persona crea su propia clave y con ella abre y cierra la tienda.</p>
        <form data-form="codigo-construccion" novalidate>
          <label class="pa-campo pa-campo--fila">El código vence en
            <select name="horas" data-vigencia-construccion></select>
          </label>
          <label class="pa-campo">Tu contraseña<input name="clave" type="password" autocomplete="current-password" required /></label>
          <label class="pa-campo" data-si-2fa hidden>Código de tu app<input name="codigo" inputmode="numeric" maxlength="11" /></label>
          <p class="pa-error" role="alert" data-error></p>
          <button class="pa-boton" type="submit">Crear código</button>
        </form>
        <div class="pa-respaldos" data-codigo-construccion hidden>
          <p><strong>Anota este código y dáselo en persona.</strong> No se volverá a mostrar. Sirve una sola vez; vence <span data-codigo-construccion-vence></span>.</p>
          <input class="pa-enlace-copiar" data-codigo-construccion-texto readonly aria-label="Código para abrir y cerrar la tienda" />
          <div class="pa-fila__botones">
            <button class="pa-boton" type="button" data-codigo-construccion-copiar>Copiar código</button>
            <button class="pa-boton pa-boton--suave" type="button" data-codigo-construccion-listo>Listo</button>
          </div>
        </div>
        <div data-codigos-construccion-caja hidden>
          <h3 class="pa-subtitulo">Códigos sin usar</h3>
          <ul class="pa-lista" data-lista-codigos-construccion></ul>
        </div>
        <div data-registro-construccion-caja hidden>
          <h3 class="pa-subtitulo">Registro</h3>
          <p class="pa-tenue pa-chico">A quién se le dio o quitó el permiso, y quién abrió o cerró la tienda, con día y hora. Últimos 50 movimientos.</p>
          <ul class="pa-lista" data-lista-registro-construccion></ul>
        </div>
      </div>

      <div class="pa-caja pa-caja--ancha">
        <h2>Cierre por inactividad</h2>
        <p class="pa-tenue">Si nadie usa el panel durante este tiempo, la sesión se cierra sola.</p>
        <label class="pa-campo pa-campo--fila">Cerrar la sesión después de
          <select data-inactividad></select>
        </label>
      </div>
    </section>
  </main>

  <!-- editor de producto -->
  <dialog class="pa-dialogo" data-editor aria-labelledby="pa-editor-titulo">
    <form data-form="producto" novalidate>
      <h2 id="pa-editor-titulo" data-editor-titulo>Producto</h2>
      <div class="pa-editor">
        <div class="pa-editor__foto">
          <p class="pa-fotos__titulo">Fotos <span class="pa-tenue" data-editor-cuenta></span></p>
          <ul class="pa-fotos" data-editor-fotos aria-label="Fotos del producto"></ul>
          <label class="pa-boton pa-boton--suave pa-archivo" data-editor-agregar>
            Agregar fotos
            <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-editor-archivo />
          </label>
          <p class="pa-tenue pa-chico">La primera es la principal: la que se ve en la tienda y en el carrito. Puedes elegir varias a la vez; se recortan cuadradas y se achican solas.</p>
          <p class="pa-error" role="alert" data-error-foto></p>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Nombre<input name="nombre" maxlength="80" required /></label>
          <p class="pa-error" data-error-campo="nombre"></p>
          <div class="pa-dos">
            <label class="pa-campo">Precio (CLP)<input name="precio" inputmode="numeric" required /></label>
            <label class="pa-campo">Disponible<input name="disponible" inputmode="numeric" placeholder="Sin límite" /></label>
          </div>
          <p class="pa-error" data-error-campo="precio"></p>
          <p class="pa-error" data-error-campo="disponible"></p>
          <p class="pa-tenue pa-chico" data-editor-vendidos></p>
          <label class="pa-campo">Categoría<select name="categoria" data-editor-categorias required></select></label>
          <p class="pa-error" data-error-campo="categoria"></p>
          <label class="pa-campo" data-editor-subcat-caja hidden>Subcategoría<select name="subcategoria" data-editor-subcategorias></select></label>
          <p class="pa-error" data-error-campo="subcategoria"></p>
          <fieldset class="pa-opciones">
            <legend>Tipo</legend>
            <label class="pa-casilla"><input type="radio" name="tipo" value="fisico" /> Físico (se despacha)</label>
            <label class="pa-casilla"><input type="radio" name="tipo" value="digital" /> Digital (curso o patrón por correo)</label>
          </fieldset>
          <p class="pa-error" data-error-campo="tipo"></p>
          <label class="pa-campo">Descripción<textarea name="descripcion" rows="4" maxlength="1000"></textarea></label>
          <p class="pa-error" data-error-campo="descripcion"></p>
          <label class="pa-campo">Video (opcional)<input name="video" inputmode="url" maxlength="300" placeholder="Pega aquí el enlace de YouTube" autocomplete="off" /></label>
          <p class="pa-tenue pa-chico">Sube el video a YouTube (puede ser un Short o "no listado"), toca Compartir → Copiar enlace y pégalo aquí. Para quitarlo, deja el campo vacío.</p>
          <p class="pa-error" data-error-campo="video"></p>
          <label class="pa-casilla"><input type="checkbox" name="destacado" /> Mostrar en "Productos destacados" del inicio</label>
        </div>
      </div>
      <section class="pa-variantes" data-editor-colores aria-labelledby="pa-colores-titulo">
        <div class="pa-variantes__cabeza">
          <h3 id="pa-colores-titulo" class="pa-subtitulo">Colores <span class="pa-tenue" data-colores-cuenta></span></h3>
          <label class="pa-campo pa-campo--fila">Se llama en la tienda
            <select data-colores-titulo><option value="Color">Color</option><option value="Modelo">Modelo</option></select>
          </label>
        </div>
        <p class="pa-tenue pa-chico">Puedes agregar <strong>hasta <span data-colores-maximo>100</span> colores</strong> (o modelos) por producto, con <strong>una foto cada uno</strong>. Si el producto viene en un solo color, no agregues ninguno. Al elegir varias fotos a la vez, el nombre de cada archivo se usa como nombre del color (por ejemplo «Azul rey.jpg»). Las unidades son por color; vacío = sin límite.</p>
        <div class="pa-aviso-fotos" data-colores-sitio hidden>
          <p><strong data-colores-sitio-texto></strong> Se usan sin tocar tus unidades, nombres ni las fotos que tú subiste.</p>
          <button class="pa-boton pa-boton--suave" type="button" data-colores-sitio-usar>Usar las fotos preparadas</button>
        </div>
        <ul class="pa-variantes__lista" data-colores-lista></ul>
        <label class="pa-boton pa-boton--suave pa-archivo" data-colores-agregar>
          + Agregar colores
          <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-colores-archivo />
        </label>
        <details class="pa-variantes__enfoque" data-colores-enfoque-caja hidden>
          <summary>Ajustar el acercamiento de las miniaturas</summary>
          <p class="pa-tenue pa-chico">Solo se usa si en «Cómo se ve la ficha» elegiste <strong>Acercamiento</strong>. Toca en la foto el punto que quieres ver de cerca; vale para todos los colores de este producto.</p>
          <div class="pa-enfoque">
            <button type="button" class="pa-enfoque__foto" data-enfoque-foto aria-label="Elegir el punto del acercamiento"><img alt="" data-enfoque-img /><span class="pa-enfoque__punto" data-enfoque-punto aria-hidden="true"></span></button>
            <div class="pa-enfoque__muestra"><span class="pa-tenue pa-chico">Así se ve</span><span class="pa-enfoque__mini"><img alt="" data-enfoque-muestra /></span></div>
          </div>
        </details>
        <p class="pa-error" role="alert" data-error-colores></p>
      </section>
      <section class="pa-variantes pa-opprod" aria-labelledby="pa-opciones-titulo">
        <div class="pa-variantes__cabeza">
          <h3 id="pa-opciones-titulo" class="pa-subtitulo">Tamaños u otras opciones <span class="pa-tenue" data-opciones-cuenta></span></h3>
          <label class="pa-campo pa-campo--fila">Se llama en la tienda<input data-opciones-titulo maxlength="20" placeholder="Tamaño" /></label>
        </div>
        <p class="pa-tenue pa-chico">Opcional. Por ejemplo <strong>Mini · Mediano · XL</strong>. Cada opción puede tener <strong>su propio precio</strong> (vacío = el del producto). Si el producto tiene colores, las unidades van <strong>por color dentro de cada opción</strong> y puedes marcar los colores en que no viene. Vacío = sin límite; 0 = agotado.</p>
        <ul class="pa-opprod__lista" data-opciones-lista></ul>
        <button type="button" class="pa-boton pa-boton--suave" data-opciones-agregar>+ Agregar opción</button>
        <p class="pa-tenue pa-chico" data-opciones-nota hidden>Los colores nuevos aparecen aquí después de guardar.</p>
        <p class="pa-error" role="alert" data-error-opciones></p>
      </section>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-editor>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar cambios</button>
      </div>
    </form>
  </dialog>

  <!-- editor de categoría -->
  <dialog class="pa-dialogo" data-editor-categoria aria-labelledby="pa-categoria-titulo">
    <form data-form="categoria" novalidate>
      <h2 id="pa-categoria-titulo" data-categoria-titulo>Categoría</h2>
      <div class="pa-editor">
        <div class="pa-editor__foto">
          <img data-categoria-foto alt="" width="240" height="240" />
          <label class="pa-boton pa-boton--suave pa-archivo">
            Elegir foto
            <input type="file" accept="image/jpeg,image/png,image/webp" data-categoria-archivo />
          </label>
          <p class="pa-tenue pa-chico">Se recorta cuadrada al centro y se achica sola.</p>
          <p class="pa-error" role="alert" data-error-foto-categoria></p>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Nombre<input name="nombre" maxlength={LIMITES_CATEGORIA.nombre} required /></label>
          <p class="pa-error" data-error-categoria="nombre"></p>
          <label class="pa-campo">Nombre corto (opcional)<input name="corto" maxlength={LIMITES_CATEGORIA.corto} /></label>
          <p class="pa-error" data-error-categoria="corto"></p>
          <p class="pa-tenue pa-chico">Se usa donde hay poco espacio: las tarjetas del inicio y los botones de la tienda. Vacío = igual al nombre.</p>
          <label class="pa-campo">Bajada (opcional)<input name="bajada" maxlength={LIMITES_CATEGORIA.bajada} /></label>
          <p class="pa-error" data-error-categoria="bajada"></p>
          <p class="pa-tenue pa-chico">Línea chica bajo el nombre en las tarjetas, si el sitio la muestra. Ejemplo: Colección satín.</p>
          <p class="pa-tenue pa-chico" data-categoria-original></p>
          <fieldset class="pa-subcats">
            <legend>Subcategorías (opcional)</legend>
            <p class="pa-tenue pa-chico">Aparecen como botones arriba de los productos de esta categoría, por ejemplo «Todos · Microfibra · Algodón», y cada una tiene su propia dirección. Hasta <span data-subcats-maximo>12</span>. Después eliges la de cada producto en Productos → Editar.</p>
            <ul class="pa-subcats__lista" data-subcats-lista></ul>
            <button type="button" class="pa-boton pa-boton--suave pa-boton--chico" data-subcats-agregar>+ Agregar subcategoría</button>
            <p class="pa-error" data-error-categoria="subcategorias"></p>
          </fieldset>
        </div>
      </div>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-categoria>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar cambios</button>
      </div>
    </form>
  </dialog>

  <!-- editor de diapositiva (portada) -->
  <dialog class="pa-dialogo" data-editor-diapo aria-labelledby="pa-diapo-titulo">
    <form data-form="diapo" novalidate>
      <h2 id="pa-diapo-titulo" data-diapo-titulo>Diapositiva</h2>
      <div class="pa-editor pa-editor--ancho">
        <div class="pa-editor__foto">
          <img class="pa-foto-ancha" data-diapo-foto alt="" width="320" height="200" />
          <label class="pa-boton pa-boton--suave pa-archivo">
            Elegir foto
            <input type="file" accept="image/jpeg,image/png,image/webp" data-diapo-archivo />
          </label>
          <p class="pa-tenue pa-chico">Mejor horizontal. Se achica sola, sin recortarla.</p>
          <p class="pa-error" role="alert" data-error-foto-diapo></p>
          <fieldset class="pa-opciones">
            <legend>Si la foto se recorta, que se vea su parte…</legend>
            <label class="pa-casilla"><input type="radio" name="enfoque" value="izquierda" /> Izquierda</label>
            <label class="pa-casilla"><input type="radio" name="enfoque" value="centro" /> Centro</label>
            <label class="pa-casilla"><input type="radio" name="enfoque" value="derecha" /> Derecha</label>
          </fieldset>
          <div class="pa-foto-movil">
            <p class="pa-foto-movil__titulo">Foto para celular (opcional)</p>
            <img class="pa-foto-movil__img" data-diapo-foto-movil alt="" width="120" height="160" hidden />
            <label class="pa-boton pa-boton--suave pa-archivo">
              Elegir foto para celular
              <input type="file" accept="image/jpeg,image/png,image/webp" data-diapo-archivo-movil />
            </label>
            <button class="pa-enlace" type="button" data-quitar-foto-movil hidden>Quitar la foto para celular</button>
            <p class="pa-tenue pa-chico">Vertical o cuadrada. Si no eliges una, en el celular se usa la foto de arriba.</p>
            <p class="pa-error" role="alert" data-error-foto-movil></p>
          </div>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Qué muestra la foto<input name="imagenAlt" maxlength={LIMITES.imagenAlt} required placeholder="Ej: gatito tejido a crochet entre ovillos de lana" /></label>
          <p class="pa-error" data-error-diapo="imagenAlt"></p>
          <label class="pa-campo">Texto chico sobre el título (opcional)<input name="antetitulo" maxlength={LIMITES.antetitulo} /></label>
          <p class="pa-error" data-error-diapo="antetitulo"></p>
          <label class="pa-campo">Título<input name="titulo" maxlength={LIMITES.titulo} /></label>
          <p class="pa-error" data-error-diapo="titulo"></p>
          <label class="pa-campo">Subtítulo (opcional)<input name="subtitulo" maxlength={LIMITES.subtitulo} /></label>
          <p class="pa-error" data-error-diapo="subtitulo"></p>
          <p class="pa-tenue pa-chico">En el título y el subtítulo, lo que escribas entre asteriscos sale en cursiva. Ejemplo: Tu cabello, *más sano,*</p>
          <label class="pa-campo">Texto (opcional)<textarea name="texto" rows="3" maxlength={LIMITES.texto}></textarea></label>
          <p class="pa-error" data-error-diapo="texto"></p>
          <div class="pa-dos">
            <label class="pa-campo">Texto del botón<input name="botonTexto" maxlength={LIMITES.botonTexto} placeholder="Ver productos" /></label>
            <label class="pa-campo">El botón lleva a<input name="enlace" maxlength={LIMITES.enlace} placeholder="/tienda/" /></label>
          </div>
          <p class="pa-error" data-error-diapo="botonTexto"></p>
          <p class="pa-error" data-error-diapo="enlace"></p>
          <p class="pa-tenue pa-chico">Una página de la tienda (ej. /tienda/flores/) o una dirección que empiece con https://. Deja los dos vacíos para no mostrar botón.</p>
        </div>
      </div>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-diapo>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar cambios</button>
      </div>
    </form>
  </dialog>

  <!-- editor de boletín -->
  <dialog class="pa-dialogo" data-editor-boletin aria-labelledby="pa-titulo-boletin">
    <form data-form="boletin" novalidate>
      <h2 id="pa-titulo-boletin">Boletín</h2>
      <div class="pa-editor pa-editor--ancho">
        <div class="pa-editor__foto">
          <img class="pa-foto-ancha" data-boletin-foto alt="" width="320" height="200" hidden />
          <p class="pa-tenue pa-chico" data-boletin-sin-foto>Sin foto (es opcional).</p>
          <label class="pa-boton pa-boton--suave pa-archivo">
            Elegir foto
            <input type="file" accept="image/jpeg,image/png,image/webp" data-boletin-archivo />
          </label>
          <button class="pa-boton pa-boton--suave pa-boton--chico" type="button" data-boletin-quitar-foto hidden>Quitar foto</button>
          <p class="pa-error" role="alert" data-error-foto-boletin></p>
        </div>
        <div class="pa-editor__campos">
          <label class="pa-campo">Asunto (lo que se ve en la bandeja de entrada)<input name="asunto" maxlength={LIMITES_BOLETIN.asunto} required placeholder="Ej: Llegaron los nuevos gatitos tejidos" /></label>
          <p class="pa-error" data-error-boletin="asunto"></p>
          <label class="pa-campo">Título dentro del correo (opcional)<input name="titulo" maxlength={LIMITES_BOLETIN.titulo} /></label>
          <p class="pa-error" data-error-boletin="titulo"></p>
          <label class="pa-campo">Mensaje<textarea name="texto" rows="8" maxlength={LIMITES_BOLETIN.texto} required placeholder="Deja una línea en blanco para separar párrafos."></textarea></label>
          <p class="pa-error" data-error-boletin="texto"></p>
          <div class="pa-dos">
            <label class="pa-campo">Texto del botón (opcional)<input name="botonTexto" maxlength={LIMITES_BOLETIN.botonTexto} placeholder="Ver la tienda" /></label>
            <label class="pa-campo">El botón lleva a<input name="botonEnlace" maxlength={LIMITES_BOLETIN.enlace} placeholder="/tienda/" /></label>
          </div>
          <p class="pa-error" data-error-boletin="boton.texto"></p>
          <p class="pa-error" data-error-boletin="boton.enlace"></p>
          <p class="pa-tenue pa-chico">Una página de la tienda (ej. /tienda/flores/) o una dirección que empiece con https://. Deja los dos vacíos para no mostrar botón.</p>
        </div>
      </div>
      <p class="pa-error" role="alert" data-error></p>
      <div class="pa-pie-dialogo">
        <button class="pa-boton pa-boton--suave" type="button" data-cerrar-boletin>Cancelar</button>
        <button class="pa-boton" type="submit">Guardar borrador</button>
      </div>
    </form>
  </dialog>

  <!-- aviso de inactividad -->
  <dialog class="pa-dialogo pa-dialogo--chico" data-aviso-inactividad>
    <h2>¿Sigues ahí?</h2>
    <p>Por seguridad, la sesión se cerrará en un minuto.</p>
    <button class="pa-boton" type="button" data-seguir>Seguir trabajando</button>
  </dialog>

  <dialog class="pa-dialogo pa-ayuda" data-ayuda aria-labelledby="pa-ayuda-titulo">
    <div class="pa-ayuda__cabeza">
      <div class="pa-titulo-seccion">
        <h2 id="pa-ayuda-titulo">Ayuda</h2>
        <button class="pa-boton pa-boton--suave pa-boton--chico" type="button" data-ayuda-cerrar>Cerrar</button>
      </div>
      <label class="pa-campo">¿Qué necesitas hacer?
        <input type="search" data-ayuda-buscar placeholder="Ej.: cambiar precio, anular pedido, vacaciones" autocomplete="off" />
      </label>
      <p class="pa-tenue pa-chico" data-ayuda-filtro hidden><span data-ayuda-filtro-texto></span> <button class="pa-enlace" type="button" data-ayuda-todo>Ver toda la ayuda</button></p>
      <p class="pa-tenue pa-chico" role="status" aria-live="polite" data-ayuda-estado></p>
    </div>
    <div class="pa-ayuda__lista" data-ayuda-lista></div>
  </dialog>

  <div class="pa-toast" role="status" aria-live="polite" data-toast hidden></div>
</div>
</body>
</html>

<style is:global>
  .pa-cuerpo { margin: 0; background: #fbf7f9; color: #221a1f; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 16px; line-height: 1.5; }
  .pa { --pa-acento: #c2185b; --pa-acento-oscuro: #9c1449; --pa-fondo: #fbf7f9; --pa-tinta: #221a1f; --pa-suave: #6e5f68; --pa-borde: #eadfe4; --pa-error: #b3261e; --pa-ok: #2f7a52; --pa-serie-1: #2a78d6; --pa-serie-2: #eb6834; --pa-serie-3: #1baf7a; --pa-serie-4: #eda100; --pa-serie-5: #e87ba4; --pa-comparacion: #2a78d6; min-height: 100vh; background: var(--pa-fondo); color: var(--pa-tinta); }
  .pa *, .pa *::before, .pa *::after { box-sizing: border-box; }
  .pa [hidden] { display: none !important; }
  .pa :focus-visible { outline: 3px solid var(--pa-acento); outline-offset: 2px; }
  .pa h1 { font-size: 1.6rem; margin: 0; font-weight: 650; }
  .pa h2 { font-size: 1.1rem; margin: 0 0 8px; font-weight: 600; }
  .pa-saltar { position: absolute; left: -9999px; }
