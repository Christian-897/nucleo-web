---
/**
 * Carrusel de portada listo para usar:
 *
 *   ---
 *   import Carrusel from "nucleo-web/carrusel/Carrusel.astro";
 *   import { fuenteCarrusel, opcionesCarrusel } from "../carrusel";
 *   ---
 *   <Carrusel fuente={fuenteCarrusel} opciones={opcionesCarrusel} />
 *
 * El diseño base (texto a la izquierda, foto a la derecha que se funde) se
 * ajusta con variables CSS desde el sitio:
 *   --carrusel-fondo, --carrusel-alto, --carrusel-ancho-imagen,
 *   --carrusel-tinta, --carrusel-acento, --carrusel-control-fondo
 * o pisando las clases .carrusel__* en el CSS del sitio.
 */
import type { FuenteCarrusel } from "../almacen";
import { atributosCarrusel, htmlCarrusel } from "../marcado";
import type { EstadoCarrusel, OpcionesCarrusel } from "../tipos";

interface Props {
  /** Carrusel editable (crearCarruselEditable). Se dibuja su versión inicial; el borde pone la editada. */
  fuente?: FuenteCarrusel;
  /** O un carrusel fijo, sin panel. */
  estado?: EstadoCarrusel;
  opciones?: OpcionesCarrusel;
  class?: string;
}
const { fuente, estado: fijo, opciones = {}, class: clase } = Astro.props;
const estado = fuente?.inicial ?? fijo;
if (!estado) throw new Error("Carrusel: falta `fuente` o `estado`.");
const nombre = (fuente?.clave ?? "carrusel:portada").replace(/^carrusel:/, "");
const html = htmlCarrusel(estado, opciones);
---
<section
  class:list={["carrusel", clase]}
  data-carrusel={nombre}
  aria-roledescription="carrusel"
  aria-label={opciones.etiqueta ?? "Destacados"}
  {...atributosCarrusel(estado)}
  set:html={html}
/>

<style is:global>
  .carrusel {
    --carrusel-alto: 420px;
    --carrusel-ancho-imagen: 58%;
    --carrusel-tinta: #1f1419;
    --carrusel-acento: #c2185b;
    --carrusel-control-fondo: rgba(255, 255, 255, .88);
    position: relative;
    overflow: hidden;
    background: var(--carrusel-fondo, #f7f2f4);
    color: var(--carrusel-tinta);
  }
  .carrusel__pista { display: grid; touch-action: pan-y; }
  .carrusel__diapo {
    grid-area: 1 / 1;
    position: relative;
    min-height: var(--carrusel-alto);
    display: grid;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity .9s ease, visibility 0s linear .9s;
  }
  .carrusel__diapo[data-activa] { opacity: 1; visibility: visible; z-index: 1; transition: opacity .9s ease; }
  .carrusel__imagen {
    position: absolute; right: 0; top: 0; height: 100%; width: var(--carrusel-ancho-imagen);
    object-fit: cover; object-position: center;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%);
    mask-image: linear-gradient(90deg, transparent 0, #000 22%);
  }
  .carrusel__imagen--izquierda { object-position: left center; }
  .carrusel__imagen--derecha { object-position: right center; }
  /* Celda de grilla: ocupa todo el ancho, salvo que la clase contenedora del sitio diga otro (y lo centre). */
  .carrusel__contenido { position: relative; z-index: 1; min-width: 0; }
  .carrusel__texto { max-width: 470px; padding-block: 48px 72px; }
  .carrusel__antetitulo { letter-spacing: .3em; text-transform: uppercase; font-size: .85rem; margin: 0 0 6px; }
  .carrusel__titulo { display: grid; justify-items: start; margin: 0 0 18px; }
  .carrusel__nombre { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.05; }
  .carrusel__subtitulo { font-size: .95rem; letter-spacing: .4em; text-transform: uppercase; margin-top: 4px; }
  .carrusel__bajada { font-size: 1.1rem; margin: 0 0 26px; max-width: 40ch; }
  .carrusel__boton-base {
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 999px;
    background: var(--carrusel-acento); color: #fff; text-decoration: none; font-weight: 600;
  }
  .carrusel__boton svg { width: 18px; height: 18px; }

  /* Controles: abajo a la derecha, sobre la foto. Ocultos hasta que el script está listo. */
  .carrusel__controles {
    position: absolute; right: 16px; bottom: 14px; z-index: 2;
    display: flex; align-items: center; gap: 2px; padding: 4px;
    background: var(--carrusel-control-fondo); border-radius: 999px;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .12);
  }
  .carrusel:not([data-listo]) .carrusel__controles { display: none; }
  .carrusel__boton-control {
    width: 40px; height: 40px; display: grid; place-items: center; padding: 0;
    border: 0; border-radius: 50%; background: transparent; color: var(--carrusel-tinta); cursor: pointer;
  }
  .carrusel__boton-control:hover { background: rgba(0, 0, 0, .06); }
  .carrusel__boton-control svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .carrusel__pausa .carrusel__icono-seguir { fill: currentColor; stroke-width: 1.5; }
  .carrusel__pausa .carrusel__icono-seguir, .carrusel__pausa[data-detenido] .carrusel__icono-pausa { display: none; }
  .carrusel__pausa[data-detenido] .carrusel__icono-seguir { display: block; }
  .carrusel__puntos { display: flex; align-items: center; }
  .carrusel__punto { width: 24px; height: 40px; display: grid; place-items: center; padding: 0; border: 0; background: none; cursor: pointer; }
  .carrusel__punto span {
    position: relative; display: block; width: 8px; height: 8px; border-radius: 999px; overflow: hidden;
    background: color-mix(in srgb, var(--carrusel-tinta) 30%, transparent);
    transition: width .3s ease;
  }
  .carrusel__punto[aria-current] { width: 38px; }
  .carrusel__punto[aria-current] span { width: 28px; }
  .carrusel__punto span::after {
    content: ""; position: absolute; inset: 0; background: var(--carrusel-acento);
    transform-origin: left center; transform: scaleX(0);
  }
  .carrusel__punto[aria-current] span::after { transform: scaleX(1); }
  .carrusel :focus-visible { outline: 3px solid var(--carrusel-acento); outline-offset: 2px; }

  @media (prefers-reduced-motion: no-preference) {
    /* Barra de progreso del punto activo: se congela cuando el carrusel se detiene. */
    .carrusel:not([data-detenido]) .carrusel__punto[aria-current] span::after {
      animation: carrusel-progreso var(--carrusel-duracion, 6s) linear both;
    }
    .carrusel:not([data-corriendo]) .carrusel__punto[aria-current] span::after { animation-play-state: paused; }
    /* Movimiento suave: la foto activa se acerca de a poco y el texto sube al entrar. */
    .carrusel__imagen { transition: transform 8s ease-out; }
    .carrusel[data-listo] .carrusel__diapo[data-activa] .carrusel__imagen { transform: scale(1.06); }
    .carrusel[data-movido] .carrusel__diapo[data-activa] .carrusel__texto > * {
      animation: carrusel-subir .8s cubic-bezier(.2, .7, .2, 1) both;
    }
    .carrusel[data-movido] .carrusel__diapo[data-activa] .carrusel__texto > :nth-child(2) { animation-delay: .08s; }
    .carrusel[data-movido] .carrusel__diapo[data-activa] .carrusel__texto > :nth-child(3) { animation-delay: .16s; }
    .carrusel[data-movido] .carrusel__diapo[data-activa] .carrusel__texto > :nth-child(4) { animation-delay: .24s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .carrusel__diapo, .carrusel__diapo[data-activa] { transition: none; }
  }
  @keyframes carrusel-progreso { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes carrusel-subir { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 760px) {
    /* Teléfono: texto arriba y foto abajo (la foto se pega al fondo si otra diapositiva es más alta). */
    .carrusel__diapo { grid-template-rows: 1fr auto; align-items: start; min-height: 0; }
    .carrusel__texto { padding-block: 32px 24px; }
    .carrusel__imagen {
      position: static; grid-row: 2; width: 100%; height: 240px;
      -webkit-mask-image: none; mask-image: none;
    }
    .carrusel[data-listo] .carrusel__diapo[data-activa] .carrusel__imagen { transform: none; }
    .carrusel__controles { right: 10px; bottom: 10px; }
  }
</style>

<script>
  import { iniciarCarruseles } from "../cliente";
  iniciarCarruseles();
</script>
